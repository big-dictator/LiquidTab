            if (!view.isAttachedToWindow) return@forEach

            val params = view.layoutParams ?: return@forEach

            if (params.height != baseHeight) {

                params.height = baseHeight

                view.layoutParams = params

            }

        }

        jdBarBaseHeights.clear()

        jdContentBaseHeights.forEach { (view, baseHeight) ->

            if (!view.isAttachedToWindow) return@forEach

            val params = view.layoutParams ?: return@forEach

            if (params.height != baseHeight) {

                params.height = baseHeight

                view.layoutParams = params

            }

        }

        jdContentBaseHeights.clear()

        jdContentWantedHeights.clear()

        jdContentAdjustedSource = null

        jdCollapsedBar = null

    }



    private fun correctJdCheckoutBar() {

