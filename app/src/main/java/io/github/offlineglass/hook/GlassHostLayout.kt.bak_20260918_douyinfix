        val content = pddMainContent ?: return

        val params = content.layoutParams

        val removeNativeInset = selectedIndex == PDD_CHAT_INDEX ||

            selectedIndex == PDD_PROMOTION_INDEX

        if (removeNativeInset && !pddChatInsetRemoved) {

            if (pddOriginalMainHeight <= 0 && params.height > 0) {

                pddOriginalMainHeight = params.height

            }

            params.height = ViewGroup.LayoutParams.MATCH_PARENT

            if (params is ViewGroup.MarginLayoutParams) params.bottomMargin = 0

            content.layoutParams = params

            content.requestLayout()

            frame.requestLayout()

            pddChatInsetRemoved = true

        } else if (!removeNativeInset && pddChatInsetRemoved) {

            if (pddOriginalMainHeight > 0) params.height = pddOriginalMainHeight

            if (params is ViewGroup.MarginLayoutParams) {

                params.bottomMargin = pddOriginalMainBottomMargin

            }

            content.layoutParams = params

            content.requestLayout()

            frame.requestLayout()

            pddChatInsetRemoved = false

