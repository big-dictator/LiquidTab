    private fun isInsideScrollContainer(view: View): Boolean {

        var node: View = view

        var guard = 0

        while (guard++ < 12) {

            val parent = node.parent as? ViewGroup ?: return false

            val name = parent.javaClass.simpleName

            if (name.contains("Scroll") || name.contains("Refresh")) return true

            node = parent

        }

        return false

    }



    /**

     * Flash-page specific: the feed is a StaggeredGrid RecyclerView whose

     * offscreen cached items are half-width TNViewGroups that otherwise match

     * the overlay signature (they even sit below the screen bottom). Shared

     * isInsideScrollContainer must stay unchanged for the cart page, so the

     * RecyclerView/ViewPager exclusion lives here only.

     */

    private fun isInsideRecyclerOrPager(view: View): Boolean {

        var node: View = view

        var guard = 0

        while (guard++ < 14) {

            val parent = node.parent as? ViewGroup ?: return false

            val name = parent.javaClass.simpleName

            if (name.contains("RecyclerView") || name.contains("ViewPager")) return true

            node = parent

        }

        return false

    }



    private fun isLastVisibleChild(view: View): Boolean {

        val parent = view.parent as? ViewGroup ?: return false

        for (index in parent.childCount - 1 downTo 0) {

            val child = parent.getChildAt(index)

            if (child.visibility == View.VISIBLE) return child === view

        }

        return false

    }



    /**

     * The checkout strip used to be lifted by the 400 ms probe only, so the

     * first frames after entering the cart page drew it at JD's native anchor

     * (behind the glass) before it jumped up. To kill the jump, detection and

     * correction now run BETWEEN layout and draw: a global-layout listener on

     * the window root fires right after RN lays the strip out, finds it and

     * offsets it in the same frame �?the wrong position is never drawn. A

     * cheap per-preDraw corrector (two getLocationInWindow calls) keeps the

     * offset alive across RN re-renders that reset it.

     */

    private fun wireJdRootLayoutProbe() {

        if (context.packageName != JD_PACKAGE) return

        val root = rootView ?: return

        if (jdRootScrollWired?.get() !== root || jdRootScrollListener == null) {

            jdRootScrollListener?.let { stale ->

                jdRootScrollWired?.get()?.viewTreeObserver?.removeOnScrollChangedListener(stale)

            }

            val scrollListener = ViewTreeObserver.OnScrollChangedListener {

                // A real content scroll is the authoritative wake-up signal for

                // the compositor sampler. Idle pages can probe slowly without

                // delaying the first moving frame.

                compositorSurfaceStaticStreak = 0

                compositorSurfaceVsyncTick = 0

                jdContentMotionUntil = SystemClock.uptimeMillis() + JD_CONTENT_MOTION_HOLD_MS

                if (jdNewProductsChannelActive) jdNewProductsSnapshotDirty = true

            }

            jdRootScrollListener = scrollListener

            jdRootScrollWired = java.lang.ref.WeakReference(root)

            root.viewTreeObserver.addOnScrollChangedListener(scrollListener)

        }

        if (jdRootLayoutWired?.get() === root && jdRootLayoutListener != null) return

        jdRootLayoutListener?.let { stale ->

            jdRootLayoutWired?.get()?.viewTreeObserver?.removeOnGlobalLayoutListener(stale)

        }

        val listener = ViewTreeObserver.OnGlobalLayoutListener {

            val flashBanner = jdFlashBanner?.get()

            val flashCart = jdFlashCart?.get()

            val flashBannerLive = flashBanner != null && flashBanner.isAttachedToWindow

            val flashCartLive = flashCart != null && flashCart.isAttachedToWindow

            if (flashBannerLive || flashCartLive) {

                correctJdFlashControls()

            }

            val bar = jdCheckoutBar?.get()

            if (bar != null && bar.isAttachedToWindow && bar.parent != null) {

                correctJdCheckoutBar()

                return@OnGlobalLayoutListener

            }

            val now = SystemClock.uptimeMillis()

            val liveRoot = rootView as? ViewGroup ?: return@OnGlobalLayoutListener

            if (liveRoot.width <= 0 || liveRoot.height <= 0) return@OnGlobalLayoutListener

            refreshJdNewProductsChannel(liveRoot, now)

            if (now - jdLastLayoutDetect < 80L) return@OnGlobalLayoutListener

            if ((jdCheckoutDiscoveryExhausted || now < jdNextCheckoutFindAt) &&

                now < jdNextFlashFindAt

            ) return@OnGlobalLayoutListener

            jdLastLayoutDetect = now

            // Flash discovery stays bounded, never locked: home channel

            // switches (秒�?�?新品) swap the page fragment but keep the same

            // NavigationGroup, and the fragment swap fires this layout

            // listener �?the only recurring entry point that can discover the

            // flash controls after the once-per-source adjust ran. The scan

            // is read-only (no layoutParams / translationY writes when

            // nothing is found), so the new-product feed never sees layout

            // churn from it.

            if (selectedIndex == 0 && !jdNewProductsChannelActive &&

                now >= jdNextFlashFindAt &&

                (!flashBannerLive || !flashCartLive)

            ) {

                val (foundBanner, foundCart) = findJdFlashBottomControls(liveRoot, liveRoot.width, liveRoot.height)

                if (foundBanner != null) jdFlashBanner = java.lang.ref.WeakReference(foundBanner)

                if (foundCart != null) jdFlashCart = java.lang.ref.WeakReference(foundCart)

                jdNextFlashFindAt = if (foundBanner != null || foundCart != null) {

                    now + 600L

                } else {

                    now + 1_200L

