    /**

     * Bilibili's TabHost snapshot contains its opaque item backgrounds. Tinting

     * that snapshot with SRC_IN turned the whole selected slot into a blue/black

     * rectangle and inherited the native row's uneven item geometry. Draw the

     * four icons from Bilibili 9.6.0's own vector path data in our fixed five-slot

     * coordinate space instead. The middle publish button remains a native-style

     * pink rounded square, while the hidden TabHost is retained only for clicks

     * and selection state.

     */

    private fun drawBilibiliNavigation(canvas: Canvas, extraScale: Float) {

        if (slotCount != 5 || width <= 0 || height <= 0) return

        val slotWidth = tabWidthPx()

        val horizontalPadding = 4f * density

        // 1.15x icon, label pushed down and icon pulled up equally so the group

        // stays centred (groupOffsetY below already re-centres the silhouette).

        val iconSize = 23f * density * config.iconScale * BILIBILI_ICON_SCALE

        val baseIconCenterY = (25f - BILIBILI_SPACING_COMPENSATION_DP) * density

        // Match the manager bar's compact but still separated icon/label pair.

        val baseLabelBaseline = (48f + BILIBILI_SPACING_COMPENSATION_DP) * density

        val selectedColor = BILIBILI_ACCENT_COLOR

        val unselectedColor = if (isDarkGlass()) {

            Color.rgb(205, 203, 210)

        } else {

            Color.rgb(44, 44, 44)

        }

        bilibiliLabelPaint.textSize = config.textSize * resources.displayMetrics.scaledDensity

        // Centre the complete icon + label silhouette, rather than two unrelated

        // fixed coordinates. This keeps the four normal tabs visually centred

        // for every configurable bar height while leaving the publish tab alone.

        val groupTop = baseIconCenterY - iconSize / 2f

        val groupBottom = baseLabelBaseline + bilibiliLabelPaint.fontMetrics.bottom

        val groupOffsetY = height / 2f - (groupTop + groupBottom) / 2f

        val iconCenterY = baseIconCenterY + groupOffsetY

        val labelBaseline = baseLabelBaseline + groupOffsetY



        val enabledIndices = enabledNavigationIndices()

        for ((visualIndex, index) in enabledIndices.withIndex()) {

            val centerX = horizontalPadding + (visualIndex + 0.5f) * slotWidth

            canvas.save()

            canvas.scale(extraScale, extraScale, centerX, height / 2f)

            if (index == BILIBILI_PUBLISH_INDEX) {

                val half = 20f * density

                val publishCenterY = height / 2f

                val publishRect = RectF(

                    centerX - half,

                    publishCenterY - half,

                    centerX + half,

                    publishCenterY + half,

                )

                bilibiliIconPaint.color = BILIBILI_ACCENT_COLOR

                canvas.drawRoundRect(publishRect, 12f * density, 12f * density, bilibiliIconPaint)

                bilibiliIconPaint.color = Color.WHITE

                bilibiliIconPaint.strokeWidth = 3.2f * density

                bilibiliIconPaint.strokeCap = Paint.Cap.ROUND

                bilibiliIconPaint.style = Paint.Style.STROKE

                canvas.drawLine(centerX - 7f * density, publishCenterY, centerX + 7f * density, publishCenterY, bilibiliIconPaint)

                canvas.drawLine(centerX, publishCenterY - 7f * density, centerX, publishCenterY + 7f * density, bilibiliIconPaint)

                bilibiliIconPaint.style = Paint.Style.FILL

                canvas.restore()

                continue

            }



            val pathIndex = if (index < BILIBILI_PUBLISH_INDEX) index else index - 1

            val selected = index == selectedIndex

            val path = if (selected) {

                bilibiliSelectedIconPaths[pathIndex]

            } else {

                bilibiliDefaultIconPaths[pathIndex]

            }

            bilibiliIconPaint.color = if (selected) selectedColor else unselectedColor

            canvas.save()

            canvas.translate(centerX - iconSize / 2f, iconCenterY - iconSize / 2f)

            val vectorScale = iconSize / BILIBILI_ICON_VIEWPORT

            canvas.scale(vectorScale, vectorScale)

            canvas.drawPath(path, bilibiliIconPaint)

            canvas.restore()



            if (!config.iconOnly) {

                bilibiliLabelPaint.color = if (selected) selectedColor else unselectedColor

                canvas.drawText(BILIBILI_LABELS[index], centerX, labelBaseline, bilibiliLabelPaint)

            }

            canvas.restore()

        }

    }



