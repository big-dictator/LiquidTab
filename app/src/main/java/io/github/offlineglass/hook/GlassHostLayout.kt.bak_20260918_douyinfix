        val now = SystemClock.uptimeMillis()

        val diagSb = StringBuilder("JdAdjust t=")

        diagSb.append(now)



        diagSb.append(" barH=").append(bar.height).append(" parentH=").append(parent.height)

        jdCollapsedBar = java.lang.ref.WeakReference(bar)



        // 2. Extend the content spine: descend through each level's largest

        // child and stretch containers that are full-width, top-anchored and

        // shortened from the bottom back to their parent's height.

        var container: ViewGroup = root

        for (depth in 0 until 6) {

            var spine: View? = null

            var bestArea = 0L

            for (index in 0 until container.childCount) {

