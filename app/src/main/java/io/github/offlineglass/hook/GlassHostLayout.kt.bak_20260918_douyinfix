        if (bar == null || !bar.isAttachedToWindow || bar.parent == null) {

            jdCheckoutBar = null

            // The checkout bar reference is stale or missing. This is expected on

            // pages without a checkout strip (home, browse). But when the user

            // switches to the cart page, the discovery lock must be lifted so the

            // layout listener can re-attempt the search. Reset periodically

            // (300ms backoff) to avoid excessive scanning.

            if (jdCheckoutDiscoveryExhausted) {

                val now = SystemClock.uptimeMillis()

                if (now >= jdCheckoutDiscoveryResetAt) {

                    jdCheckoutDiscoveryResetAt = now + 300L

                    jdCheckoutDiscoveryExhausted = false

                    jdNextCheckoutFindAt = 0L

                }

