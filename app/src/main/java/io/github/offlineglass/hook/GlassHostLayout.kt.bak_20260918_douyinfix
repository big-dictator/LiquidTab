        var hops = 0

        while (shell != null && hops < 5 && shell !is GlassHostLayout) {

            clearTiebaSurface(shell)

            shell.clipChildren = false

            shell.clipToPadding = false

            shell = shell.parent as? ViewGroup

            hops++

        }

        removeTiebaNativeTabInset(source)

    }

