        val rootHeight = (rootView as? View)?.height ?: return

        if (rootHeight <= 0 || width <= 0 || height <= 0) return

        val hostLocation = IntArray(2).also(::getLocationInWindow)

        // Cart-only target per user request: the strip's bottom sits just

        // above the glass top (8 px) instead of the default bottom-inset

        // rhythm, on JD's cart page only.

        val safeBottom = hostLocation[1] - JD_CHECKOUT_BOTTOM_GAP_PX

        val barLocation = IntArray(2).also(bar::getLocationInWindow)

        val delta = barLocation[1] + bar.height - safeBottom

        if (kotlin.math.abs(delta) > 6) {

            bar.offsetTopAndBottom(-delta)

            jdCheckoutOffsets[bar] = (jdCheckoutOffsets[bar] ?: 0) - delta

        }

        correctJdBackToTopButton()

