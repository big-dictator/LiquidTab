    /**

     * YouTube's pivot_bar row is a HorizontalScrollView of Buttons. Its native

     * per-button ripple/pill backgrounds and the scroll view's fading edges are

     * captured by the projection snapshot and would resurface on the glass as

     * grey residue. Strip only container surfaces: the icon/label content of

     * each Button is drawn by the Button itself and stays intact.

     */

    /**

     * Tieba's native bottom strip fights passive suppression: it re-asserts

     * the tab-row background through FragmentTabWidget.setNavigationBarBg on

     * tab switches and parks a full-width nav-bar scrim View below the app

     * root - each resurfacing as the leftover line / colour block around the

     * floating glass panel.

     *

     * v6 tried translating the whole bar shell off-screen (the WeChat

     * recipe) but the geometry change dragged the glass panel's sampling and

     * layout along with it and the bottom bar vanished entirely. v7 keeps

     * the strip exactly where it is - the background restore is neutralised

     * at the source by an Xposed hook on setNavigationBarBg (see

     * TargetHooks.installTiebaNavigationBarBgSuppression) - clears any

     * surfaces that still slip through every pre-draw, hides the scrim, and

     * stretches the window's own view chain to full height so page content,

     * not a flat background, shows behind the glass.

     */

    /**

     * Keep Home's bottom action controls above LiquidTab using the common safe

     * gap. Only the two confirmed floating controls are moved; feed cards and

     * RecyclerView content keep their native geometry.

     */

    private fun adjustTiebaHomeBottomControls() {

        if (context.packageName != TIEBA_PACKAGE || width <= 0 || height <= 0) return

        val root = rootView as? ViewGroup ?: return



        val now = SystemClock.uptimeMillis()

        if (now - lastTiebaBottomControlProbe >= TIEBA_BOTTOM_CONTROL_PROBE_INTERVAL_MS) {

            lastTiebaBottomControlProbe = now

            // Hide the "switch to single-column" promo banner instead of lifting

            // it; it would otherwise stack above LiquidTab.

            findTiebaLabelView(root) { text ->

                TIEBA_COLUMN_TIP_LABELS.any(text::contains)

            }?.let { label -> findTiebaBottomControl(label, root) }

                ?.takeIf { it.visibility != View.GONE }

                ?.apply { visibility = View.GONE; postInvalidateOnAnimation() }

            val recommend = findTiebaLabelView(root) { text ->

                TIEBA_RECOMMEND_CONTROL_LABELS.any(text::contains)

            }?.let { label -> findTiebaBottomControl(label, root) }

            val liveSearch = findTiebaLabelView(root) { text ->

                TIEBA_LIVE_SEARCH_LABELS.any(text::contains)

            }?.let { label -> findTiebaBottomControl(label, root) }

            tiebaRecommendLayoutControl = replaceTiebaBottomControl(

                tiebaRecommendLayoutControl,

                recommend,

            )

            tiebaLiveSearchControl = replaceTiebaBottomControl(

                tiebaLiveSearchControl,

                liveSearch,

            )

        }



        liftTiebaBottomControl(tiebaRecommendLayoutControl)

        liftTiebaBottomControl(tiebaLiveSearchControl)

        transparentizeTiebaBottomBlock()

    }



    /**

     * The default-mode native bar lives in `bottomNavigatorContainer` instead of

     * the `FragmentTabWidget` that suppressNativeTiebaBottomBar clears, so its

     * opaque background can still peek out below the glass as a solid block over

     * the feed. Periodically strip backgrounds from any full-width band that

     * spans from under the glass down to the screen edge.

     */

    private fun transparentizeTiebaBottomBlock() {

        if (context.packageName != TIEBA_PACKAGE) return

        val root = rootView as? ViewGroup ?: return

        if (root.width <= 0 || root.height <= 0) return

        val now = SystemClock.uptimeMillis()

        if (now - tiebaBottomBlockScanAt < 600L) return

        tiebaBottomBlockScanAt = now



        val hostRect = Rect()

        if (!getGlobalVisibleRect(hostRect) || hostRect.width() <= 0) return

        val bandTop = hostRect.bottom - (48f * density).toInt()

        val minSide = (72f * density).toInt()

        val edgePad = (56f * density).toInt()



        val stack = ArrayDeque<View>()

        stack += root

        var visited = 0

        while (stack.isNotEmpty() && visited++ < 3072) {

            val view = stack.removeLast()

            if (view === this || view.visibility != View.VISIBLE) continue

            if (view is ViewGroup) {

                val r = Rect()

                if (view.getGlobalVisibleRect(r) &&

                    r.width() >= root.width - minSide * 2 &&

                    r.top >= bandTop &&

                    r.top < hostRect.bottom + (640f * density).toInt() &&

                    r.bottom >= root.height - edgePad &&

                    r.height() >= (20f * density).toInt()

                ) {

                    if (tiebaBottomBlocks[view] != true &&

                        (view.background != null || view.foreground != null)

                    ) {

                        android.util.Log.i(

                            "LiquidTab",

                            "tieba block bg removed: ${view.javaClass.name} rect=$r",

                        )

                        clearTiebaSurface(view)

                        tiebaBottomBlocks[view] = true

                        postInvalidateOnAnimation()

                    }

                }

                for (i in 0 until view.childCount) stack += view.getChildAt(i)

            }

        }

    }



    private fun resolveTiebaHomeSubpage(root: ViewGroup): Int {

        val topLimit = (TIEBA_HOME_TAB_MAX_BOTTOM_DP * density).toInt()

        val stack = ArrayDeque<Pair<View, Int>>()

        stack += root to 0

        var visited = 0

        while (stack.isNotEmpty() && visited++ < 512) {

            val (view, depth) = stack.removeLast()

            if (view.visibility != View.VISIBLE || view.alpha <= 0.01f) continue

            if (view is TextView && view.isSelected) {

                val text = view.text?.toString().orEmpty()

                if (text == TIEBA_RECOMMEND_TAB_LABEL || text == TIEBA_LIVE_TAB_LABEL) {

                    val location = IntArray(2).also(view::getLocationInWindow)

                    if (location[1] + view.height <= topLimit) {

                        return if (text == TIEBA_LIVE_TAB_LABEL) {

                            TIEBA_HOME_SUBPAGE_LIVE

                        } else {

                            TIEBA_HOME_SUBPAGE_RECOMMEND

                        }

                    }

                }

            }

            if (view is ViewGroup && depth < 12) {

                for (index in 0 until view.childCount) stack += view.getChildAt(index) to (depth + 1)

            }

        }

        return TIEBA_HOME_SUBPAGE_UNKNOWN

    }



    private fun findTiebaLabelView(root: ViewGroup, matches: (String) -> Boolean): View? {

        // Breadth-first traversal reaches shallow floating controls before the

        // thousands of descendants in the feed RecyclerView. The old DFS cap

        // was exhausted inside feed cards before either bottom control was seen.

        val queue = ArrayDeque<Pair<View, Int>>()

        queue += root to 0

        var visited = 0

        while (queue.isNotEmpty() && visited++ < TIEBA_BOTTOM_CONTROL_MAX_VISITED_VIEWS) {

            val (view, depth) = queue.removeFirst()

            if (view.visibility != View.VISIBLE || view.alpha <= 0.01f) continue

            val text = (view as? TextView)?.text?.toString().orEmpty()

            val description = view.contentDescription?.toString().orEmpty()

            if ((text.isNotEmpty() && matches(text)) ||

                (description.isNotEmpty() && matches(description))

            ) return view

            if (view is ViewGroup && depth < TIEBA_BOTTOM_CONTROL_MAX_DEPTH) {

                for (index in 0 until view.childCount) {

                    queue += view.getChildAt(index) to (depth + 1)

                }

            }

        }

        return null

    }



    private fun findTiebaBottomControl(label: View, root: ViewGroup): View? {

        val rootLocation = IntArray(2).also(root::getLocationInWindow)

        val rootBottom = rootLocation[1] + root.height

        val minimumBottom = rootBottom - TIEBA_BOTTOM_CONTROL_BOTTOM_ZONE_DP * density

        val maximumHeight = (TIEBA_BOTTOM_CONTROL_MAX_HEIGHT_DP * density).toInt()

        var current: View? = label

        var best: View? = null

        repeat(8) {

            val candidate = current ?: return@repeat

            if (candidate === root) return@repeat

            val location = IntArray(2).also(candidate::getLocationInWindow)

            val bottomAnchored = location[1] + candidate.height >= minimumBottom

            val reasonableGeometry = candidate.width in 1..(root.width * 0.96f).toInt() &&

                candidate.height in 1..maximumHeight

            if (candidate.visibility == View.VISIBLE && candidate.alpha > 0.01f &&

                bottomAnchored && reasonableGeometry

            ) {

                // Prefer the first native click owner so text, icon, background

                // and hit target move as one unit. When Tieba exposes no click

                // owner, retain the outermost small background carrier.

                if (candidate.isClickable || candidate.hasOnClickListeners()) return candidate

                if (candidate === label || candidate.background != null) best = candidate

            }

            current = candidate.parent as? View

        }

        return best

    }



    private fun replaceTiebaBottomControl(previous: View?, current: View?): View? {

        if (previous !== current) restoreTiebaBottomControl(previous)

        return current

    }



    private fun restoreTiebaBottomControl(view: View?) {

        if (view == null) return

        val base = tiebaBottomControlBaseTranslations.remove(view) ?: return

        if (abs(view.translationY - base) > 0.5f) view.translationY = base

    }



    private fun liftTiebaBottomControl(target: View?) {

        if (target == null || !target.isAttachedToWindow || target.visibility != View.VISIBLE) return

        val hostRect = Rect()

        if (!getGlobalVisibleRect(hostRect)) return

        val safeBottom = hostRect.top - globalGlassBottomGapPx(this)

        val base = tiebaBottomControlBaseTranslations.getOrPut(target) { target.translationY }

        val location = IntArray(2).also(target::getLocationInWindow)

        val appliedOffset = target.translationY - base

        val naturalBottom = location[1] + target.height - appliedOffset

        val desiredOffset = minOf(0f, safeBottom - naturalBottom)

        val desiredTranslation = base + desiredOffset

        if (abs(target.translationY - desiredTranslation) > 0.5f) {

            target.translationY = desiredTranslation

        }

    }



    private fun restoreAllTiebaBottomControls() {

        tiebaBottomControlBaseTranslations.forEach { (view, base) ->

            if (abs(view.translationY - base) > 0.5f) view.translationY = base

        }

        tiebaBottomControlBaseTranslations.clear()

        tiebaRecommendLayoutControl = null

        tiebaLiveSearchControl = null

        lastTiebaBottomControlProbe = 0L

    }



    private fun suppressNativeTiebaBottomBar(source: ViewGroup?) {

        if (context.packageName != TIEBA_PACKAGE || source == null) return



        if (TIEBA_TEST_MODE) {

            // Test mode: The navigationSource (FragmentTabWidget) is the tab

            // content host, NOT the bottom bar. The actual bottom bar is

            // bottomNavigatorContainer > BottomNavigator + bottomNavigatorExtension,

            // located elsewhere in the view tree. Walk the root view tree to

            // find the BottomNavigator and hide its entire parent container.

            // NOTE: findViewByClassName currently returns false �?see

            // 04-贴吧测试分支适配交接.md for diagnosis and next steps.

            val root = rootView

            val bottomNav = findViewByClassName(root, "BottomNavigator")

            if (bottomNav != null) {

                val container = bottomNav.parent as? ViewGroup

                if (container != null) {

                    container.alpha = 0f

                    clearTiebaSurface(container)

                    container.clipChildren = false

                    container.clipToPadding = false

                    for (i in 0 until container.childCount) {

                        val child = container.getChildAt(i) ?: continue

