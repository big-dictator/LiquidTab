        updatePddPromotionNativeBlur(

            promotionSelected && !pddPromotionSurfacePipelineActive,

        )

    }



    /**

     * Xiaomi Market restores these layers from onBottomTabBlurSwitch() and

     * updateBottomTabLayoutBgColor() after installation, tab changes and theme

     * changes. Keep the native controller alive, but clear only its chrome on

     * every pre-draw so the page remains the sole input to the glass renderer.

     */

    private fun suppressNativeMiMarketBottomBar(source: ViewGroup?) {

        if (context.packageName != MI_MARKET_PACKAGE || source == null) return

        val bottomTab = findMiMarketBottomTabLayout() ?: return



        // Icons and labels are redrawn from Xiaomi Market's own extracted

        // selected/unselected resources. The retained native row is controller

        // state only; if its pixels remain visible they are captured into the

        // backdrop and appear as a rectangular colour block beneath the pill.

        if (source.alpha != 0f) source.alpha = 0f

        if (bottomTab !== source && bottomTab.alpha != 0f) bottomTab.alpha = 0f



        fun clearBackground(view: View) {

            if (view.background != null) view.background = null

            if (view.backgroundTintList != null) view.backgroundTintList = null

            if (view.foreground != null && viewResourceEntryName(view) in MI_MARKET_CHROME_IDS) {

                view.foreground = null

            }

        }



        clearBackground(source)

        clearBackground(bottomTab)



        var shell: ViewGroup? = bottomTab

        repeat(5) {

            val current = shell ?: return@repeat

            if (viewResourceEntryName(current) == "tab_container_layout") return@repeat

            shell = current.parent as? ViewGroup

        }

        val container = shell?.takeIf { viewResourceEntryName(it) == "tab_container_layout" }

            ?: (bottomTab.parent as? ViewGroup)

            ?: return

        clearBackground(container)

        container.clipChildren = false

        container.clipToPadding = false



        // Same class of residual block as Xiaomi Community: root_view spans

        // the full window (2656 px) but its only child fragment_root_view is

        // shortened by the gesture-bar inset (~51 px), so the feed stops

        // above the window bottom and the strip underneath shows through as

        // a solid band beneath the floating bar. Restore full-bleed height �?

        // the inset lives either on fragment_root_view's own LayoutParams or

        // as root_view's bottom padding; clear both idempotently. The glass

        // host is a content sibling anchored by a screen-relative margin, so

        // its position is untouched, and the suppressed native row only

        // supplies state (performClick / show(index) / mCurrentTabIndex are

        // all position-independent).

        (container.parent as? ViewGroup)?.let { contentRoot ->

            val rootParams = contentRoot.layoutParams as? ViewGroup.MarginLayoutParams

            if (rootParams != null) {

                var changed = false

                if (rootParams.height != ViewGroup.LayoutParams.MATCH_PARENT) {

                    rootParams.height = ViewGroup.LayoutParams.MATCH_PARENT

                    changed = true

                }

                if (rootParams.bottomMargin != 0) {

                    rootParams.bottomMargin = 0

                    changed = true

                }

                if (changed) {

                    contentRoot.layoutParams = rootParams

                    contentRoot.requestLayout()

                    android.util.Log.i("MkGlassDiag", "fragment_root_view full-bleed applied")

                }

            }

            (contentRoot.parent as? ViewGroup)?.let { outer ->

                if (outer.paddingBottom != 0) {

                    outer.setPadding(outer.paddingLeft, outer.paddingTop, outer.paddingRight, 0)

                    outer.requestLayout()

                    android.util.Log.i("MkGlassDiag", "root_view paddingBottom cleared")

                }

                // The real culprit behind the residual band: Xiaomi Market

                // reserves the gesture-bar band with an INVISIBLE

                // navigation_bar_placeholder sibling of fragment_root_view. An

                // INVISIBLE view still occupies layout space, so even a

                // MATCH_PARENT fragment_root_view stays squeezed to

                // window-height-minus-51px and the band shows the window

                // background. The app re-asserts the placeholder's height

                // every layout pass, so collapse it idempotently each pass:

                // GONE removes it from measurement entirely and a zeroed

                // LayoutParams keeps it harmless even if the app only resets

                // its height.

                for (childIndex in 0 until outer.childCount) {

                    val child = outer.getChildAt(childIndex)

                    if (viewResourceEntryName(child) != "navigation_bar_placeholder") continue

                    var placeholderChanged = false

                    if (child.visibility != View.GONE) {

                        child.visibility = View.GONE

                        placeholderChanged = true

                    }

                    val childLp = child.layoutParams

                    if (childLp is ViewGroup.MarginLayoutParams &&

                        (childLp.height != 0 || childLp.topMargin != 0 || childLp.bottomMargin != 0)

                    ) {

                        childLp.height = 0

                        childLp.topMargin = 0

                        childLp.bottomMargin = 0

                        child.layoutParams = childLp

                        placeholderChanged = true

                    }

                    if (placeholderChanged) {

                        child.requestLayout()

                    }

                }



            }

        }



        var scanRoot = container

        repeat(3) { scanRoot = (scanRoot.parent as? ViewGroup) ?: scanRoot }

