     * main_radio container and walking up to its TabHost grandparent.

     * This is robust against navigationSource becoming stale after tab rebuilds.

     */

    fun findWeiboTabHost(): ViewGroup? {

        val activity = context.findActivity() ?: return null

        val content = activity.findViewById<ViewGroup>(android.R.id.content) ?: return null

        // Search for main_radio or a container with TabViewGroupV2 children

        val stack = ArrayDeque<View>()

        stack.add(content)

        var mainRadio: View? = null

        while (stack.isNotEmpty()) {

            val view = stack.removeLast()

            val name = viewResourceEntryName(view).orEmpty()

            if (name == "main_radio" || name == "main_theme_radio") {

                mainRadio = view

                break

            }

            if (view is ViewGroup) {

                for (i in 0 until view.childCount) {

                    stack.add(view.getChildAt(i))

                }

            }

        }

        // Fallback: use cached navigationSource if still attached

        if (mainRadio == null) {

            val src = navigationSource?.takeIf { it.isAttachedToWindow } ?: return null

            val shell = src.parent as? ViewGroup ?: return null

            return shell.parent as? ViewGroup

        }

        val shell = mainRadio.parent as? ViewGroup ?: return null

        return shell.parent as? ViewGroup

    }



    /**

     * JD rebuilds its NavigationGroup on page switches. Until the host

     * rebinds, the old source is detached and the freshly created bar draws

     * unsuppressed for several frames �?a native-bar flicker at the bottom.

     * Detect the stale source in the same preDraw pass and re-bind by class

     * name, then immediately suppress the new bar and let the content

     * adjuster re-run on the next frame (throttle reset), so the wrong

     * artwork is never drawn.

     */

    fun refreshJdNavigationSource(): Boolean {

        if (context.packageName != JD_PACKAGE) return false

        val current = navigationSource

        if (current != null && current.isAttachedToWindow && current.width > 0) return false

        val activity = context.findActivity() ?: return false

        val content = activity.findViewById<ViewGroup>(android.R.id.content) ?: return false

        // While the source is stale this runs every preDraw frame. Cache the

        // bar's class so matching is one reference comparison per view, and

        // cap the depth so deep ReactNative feed subtrees are never entered:

        // the bar stack sits ~5 levels below the content root.

        val wanted = jdNavigationGroupClass

        val stack = ArrayDeque<Pair<View, Int>>()

        stack += content to 0

        var visited = 0

        while (stack.isNotEmpty() && visited++ < 600) {

            val (view, depth) = stack.removeLast()

            if (view is ViewGroup) {

                val matched = if (wanted != null) view.javaClass === wanted

                else view.javaClass.simpleName == "NavigationGroup"

                if (matched) {

                    jdNavigationGroupClass = view.javaClass

                    navigationSource = view

                    // A newly created native bar marks a real JD page rebuild.

                    // Allow one fresh bottom-control discovery for that new

                    // hierarchy; ordinary feed updates keep this same instance.

                    jdCheckoutDiscoveryExhausted = false

                    jdNextCheckoutFindAt = 0L

                    jdNextFlashFindAt = 0L

                    // Synchronous work stays minimal �?just the cheap alpha/

                    // background suppression that prevents the flicker. The

                    // heavy parts (bar-stack collapse + content re-extension,

                    // which force a full re-layout of the new page) run on

                    // the NEXT frame so they never pile onto JD's own

                    // page-build frame. The checkout search keeps its

                    // backoff; the global-layout probe still finds the strip

                    // before its first draw on the cart page.

                    suppressNativeJdBottomBar(view)

                    postOnAnimation {

                        if (isAttachedToWindow && navigationSource === view) {

                            jdContentAdjustedSource = null

                            adjustJdContentFullscreen()

                        }

                    }

                    postInvalidateOnAnimation()

                    return true

                }

                if (depth < 12) {

                    for (index in 0 until view.childCount) {

                        stack += view.getChildAt(index) to (depth + 1)

                    }

                }

            }

        }

        return false

    }



    /**

     * Mi Health rebuilds its material TabLayout when returning from a device

     * sub-page. The retained navigationSource keeps pointing at the detached

     * old row, so tab taps resolve no live Tab.select() receiver and the pill

     * snaps back �?while the snapshot keeps rendering the stale row. Re-bind

     * to the live main_tl_bottom instance the same frame it is discovered.

     */

    fun refreshMiHealthNavigationSource(): Boolean {

        if (context.packageName != MI_HEALTH_PACKAGE) return false

        val current = navigationSource

        val currentIsAuthoritative = current != null && current.isAttachedToWindow &&

            current.width > 0 && current.height > 0 &&

            current.javaClass.name == MI_HEALTH_TAB_LAYOUT_CLASS &&

            viewResourceEntryName(current) == "main_tl_bottom"

        if (currentIsAuthoritative) return false

        android.util.Log.i(

            "MhGlassDiag",

            "refresh: source invalid cls=${current?.javaClass?.simpleName} " +

                "id=${current?.let(::viewResourceEntryName)} " +

                "attached=${current?.isAttachedToWindow} w=${current?.width} -> searching",

        )

        val root = rootView as? ViewGroup ?: return false

        val stack = ArrayDeque<Pair<View, Int>>()

        stack += root to 0

        var visited = 0

        while (stack.isNotEmpty() && visited++ < 600) {

            val (view, depth) = stack.removeLast()

            if (view is ViewGroup && view !== current && view.isAttachedToWindow &&

                view.width > 0 && view.height > 0 &&

                view.javaClass.name == MI_HEALTH_TAB_LAYOUT_CLASS &&

                viewResourceEntryName(view) == "main_tl_bottom"

            ) {

                navigationSource = view

                if (view.alpha != 0f) view.alpha = 0f

                view.background = null

                view.backgroundTintList = null

                // The rebuilt row needs the same overlay geometry the install

                // path applies: negative topMargin + hidden divider, or the

                // native row reappears at its stock position above the glass.

                GlassInstaller.applyMiHealthOverlayLayout(view, density)

                view.post { GlassInstaller.applyMiHealthOverlayLayout(view, density) }

                // Force the projected row to be re-captured from the new

                // instance instead of freezing the detached row's pixels.

                navigationSnapshotSignature = Long.MIN_VALUE

                pendingNavigationSignature = Long.MIN_VALUE

                pendingNavigationStableFrames = 0

                postInvalidateOnAnimation()

                android.util.Log.i("MhGlassDiag", "refresh: REBOUND to ${System.identityHashCode(view)}")

                return true

            }

            if (view is ViewGroup && depth < 12) {

                for (index in 0 until view.childCount) {

                    stack += view.getChildAt(index) to (depth + 1)

                }

            }

        }

        android.util.Log.i("MhGlassDiag", "refresh: NO live TabLayout found (visited=$visited)")

        return false

    }



    /**

     * The file manager owns two bars that replace each other across UI modes:

     * the multi-select action bar (split_action_bar, created/destroyed with

     * each selection session) and the main tab row (bottom_navigation_container,

     * 最近/浏览 plus the standalone circular search key). ScannerSession locks

     * `installed` after the first install and never scans again, so every

     * subsequent switch must re-bind here: prefer the live action bar, fall

     * back to the main tab row, and re-parameterize the host (slider, slot

     * count, non-selectable search key, geometry) for the bound bar.

     */

    fun refreshFileManagerNavigationSource(): Boolean {

        if (context.packageName != FILE_MANAGER_PACKAGE) return false

        val current = navigationSource

        val currentId = current?.takeIf {

            it.isAttachedToWindow && it.width > 0 && it.height > 0

        }?.let { viewResourceEntryName(it) }

        val currentIsAuthoritative = currentId == FILE_MANAGER_ACTION_BAR_ID ||

            currentId == FILE_MANAGER_BOTTOM_NAV_ID

        if (currentIsAuthoritative) {

            val content = parent as? ViewGroup ?: return false

            val rect = if (currentId == FILE_MANAGER_BOTTOM_NAV_ID) {

                GlassInstaller.fileManagerMainPillRect(current as ViewGroup, content)

            } else {

                GlassInstaller.floatingPillRect(current as ViewGroup, content)

            } ?: return false

            val params = layoutParams as? FrameLayout.LayoutParams ?: return false

            val targetRight = (content.width - rect.right).coerceAtLeast(0)

            val targetBottom = (content.height - rect.bottom).coerceAtLeast(0)

            if (params.width == rect.width() &&

                params.height == rect.height() &&

                params.leftMargin == rect.left &&

                params.rightMargin == targetRight &&

                params.bottomMargin == targetBottom

            ) return false

            params.width = rect.width()

            params.height = rect.height()

            params.leftMargin = rect.left

            params.rightMargin = targetRight

            params.bottomMargin = targetBottom

            layoutParams = params

            requestLayout()

            navigationSnapshotSignature = Long.MIN_VALUE

            pendingNavigationSignature = Long.MIN_VALUE

            pendingNavigationStableFrames = 0

            postInvalidateOnAnimation()

            return true

        }

        val root = rootView as? ViewGroup ?: return false

        var fresh: ViewGroup? = null

        val stack = ArrayDeque<Pair<View, Int>>()

        stack += root to 0

        var visited = 0

        while (stack.isNotEmpty() && visited++ < 800) {

            val (view, depth) = stack.removeLast()

            if (view is ViewGroup && view !== current && view.isAttachedToWindow &&

                view.width > 0 && view.height > 0 && view.visibility == View.VISIBLE &&

                viewResourceEntryName(view) == FILE_MANAGER_ACTION_BAR_ID

            ) {

                fresh = view

                break

            }

            if (view is ViewGroup && depth < 12) {

                for (index in 0 until view.childCount) {

                    stack += view.getChildAt(index) to (depth + 1)

                }

            }

        }

        if (fresh == null) {

            val fallback = ArrayDeque<Pair<View, Int>>()

            fallback += root to 0

            visited = 0

            while (fallback.isNotEmpty() && visited++ < 800) {

                val (view, depth) = fallback.removeLast()

                if (view is ViewGroup && view !== current && view.isAttachedToWindow &&

                    view.width > 0 && view.height > 0 && view.visibility == View.VISIBLE &&

                    viewResourceEntryName(view) == FILE_MANAGER_BOTTOM_NAV_ID

                ) {

                    fresh = view

                    break

                }

                if (view is ViewGroup && depth < 12) {

                    for (index in 0 until view.childCount) {

                        fallback += view.getChildAt(index) to (depth + 1)

                    }

                }

            }

        }

        val navigation = fresh ?: return false

        val content = parent as? ViewGroup

        val isActionBar = viewResourceEntryName(navigation) == FILE_MANAGER_ACTION_BAR_ID

        navigationSource = navigation

        if (navigation.alpha != 0f) navigation.alpha = 0f

        if (navigation.background != null) navigation.background = null

        sliderEnabled = !isActionBar

        nonSelectableIndices = if (isActionBar) emptySet() else setOf(2)

        if (isActionBar) {

            // Multi-select bar: bind the pill itself (not the full-width

            // container) as the projection source and derive the slot count

            // from its action buttons.

            var pill: ViewGroup? = null

            if (content != null) {

                val rect = GlassInstaller.floatingPillRect(navigation, content)

                if (rect != null) {

                    pill = GlassInstaller.floatingPillSource(navigation, content, rect)

                    val params = layoutParams as? FrameLayout.LayoutParams

                    if (params != null) {

                        params.width = rect.width()

                        params.height = rect.height()

                        params.leftMargin = rect.left

                        params.rightMargin = (content.width - rect.right).coerceAtLeast(0)

                        params.bottomMargin = (content.height - rect.bottom).coerceAtLeast(0)

                        layoutParams = params

                        requestLayout()

                    }

                }

            }

            if (pill == null) {

                pill = (0 until navigation.childCount)

                    .mapNotNull { navigation.getChildAt(it) as? ViewGroup }

                    .firstOrNull { it.visibility == View.VISIBLE && it.width > 0 && it.height > 0 }

            }

            if (pill != null) {

                navigationSource = pill

                slotCount = pill.childCount.coerceIn(2, 7)

            }

        } else {

            // Main tab row: artwork is drawn from the extracted static cache,

            // so the container itself stays the extraction source. Re-pin the

            // host over the whole native pill (tabs + search circle).

            slotCount = 3

            if (content != null) {

                val rect = GlassInstaller.fileManagerMainPillRect(navigation, content)

                if (rect != null) {

                    val params = layoutParams as? FrameLayout.LayoutParams

                    if (params != null) {

                        params.width = rect.width()

                        params.height = rect.height()

                        params.leftMargin = rect.left

                        params.rightMargin = (content.width - rect.right).coerceAtLeast(0)

                        params.bottomMargin = (content.height - rect.bottom).coerceAtLeast(0)

                        layoutParams = params

                        requestLayout()

                    }

                }

            }

        }

        // Re-extract main-bar artwork after any re-bind; the multi-select bar

        // stays on the generic snapshot path.

        fmStaticIconsPopulated = false

        fmLastCaptureSignature = Long.MIN_VALUE

        fmStableFrames = 0

        navigationSnapshotSignature = Long.MIN_VALUE

        pendingNavigationSignature = Long.MIN_VALUE

        pendingNavigationStableFrames = 0

        postInvalidateOnAnimation()

        XposedBridge.log(

            "[OfflineGlass][FileManager] re-bound " +

                (if (isActionBar) "action-bar" else "main-tab-row") +

                " slots=$slotCount slider=$sliderEnabled",

        )

        return true

    }



    private fun findMiHealthViewPager(): View? {

        val root = rootView as? ViewGroup ?: return null

        val stack = ArrayDeque<Pair<View, Int>>()

        stack += root to 0

        var visited = 0

        while (stack.isNotEmpty() && visited++ < 800) {

            val (view, depth) = stack.removeLast()

            if (view.javaClass.name == "androidx.viewpager.widget.ViewPager" &&

                viewResourceEntryName(view) == "viewPager" && view.isAttachedToWindow

            ) return view

            if (view is ViewGroup && depth < 12) {

                for (index in 0 until view.childCount) {

                    stack += view.getChildAt(index) to (depth + 1)

                }

            }

        }

        return null

    }



    private fun miHealthTabListenerCount(tabLayout: ViewGroup?): Int {

        if (tabLayout == null) return -1

        return runCatching {

            var clazz: Class<*>? = tabLayout.javaClass

            while (clazz != null && clazz != Any::class.java) {

                for (field in clazz.declaredFields) {

                    if (!List::class.java.isAssignableFrom(field.type)) continue

                    if (!field.name.contains("listener", true)) continue

                    field.isAccessible = true

                    val value = field.get(tabLayout) as? List<*> ?: continue

                    return@runCatching value.size

                }

                clazz = clazz.superclass

            }

            -2

        }.getOrDefault(-4)

    }



    private fun logMiHealthDiag() {

        val now = android.os.SystemClock.uptimeMillis()

        if (now - lastMhDiagLog < 2000L) return

        lastMhDiagLog = now

        val source = navigationSource

        val live = findMiHealthTabLayout()

        val pager = findMiHealthViewPager()

        val currentItem = pager?.let {

            runCatching {

                (XposedHelpers.callMethod(it, "getCurrentItem") as? Number)?.toInt()

            }.getOrNull()

        }

        android.util.Log.i(

            "MhGlassDiag",

            "state src=${source?.let { System.identityHashCode(it) }} " +

                "cls=${source?.javaClass?.simpleName}/${source?.let { viewResourceEntryName(it) ?: "no-id" }} " +

                "att=${source?.isAttachedToWindow} w=${source?.width} vis=${source?.visibility} " +

                "alpha=${source?.alpha} live=${live?.let { System.identityHashCode(it) }} " +

                "listeners=${miHealthTabListenerCount(live)} tabs=${miHealthTabCount(live)} " +

                "pager=${pager != null} cur=$currentItem selected=$selectedIndex slots=$slotCount",

        )

    }



    private fun miHealthTabCount(tabLayout: ViewGroup?): Int? = tabLayout?.let {

        runCatching {

            (XposedHelpers.callMethod(it, "getTabCount") as? Number)?.toInt()

        }.getOrNull()

    }



    fun refreshWeiboNavigationSource(): Boolean {

        if (context.packageName != WEIBO_PACKAGE) return false

        val current = navigationSource

        if (current != null && current.isAttachedToWindow && current.width > 0) return false

        // Search for main_radio in the activity's content view

        val activity = context.findActivity() ?: return false

        val content = activity.findViewById<ViewGroup>(android.R.id.content) ?: return false

        val stack = ArrayDeque<View>()

        stack.add(content)

        while (stack.isNotEmpty()) {

            val view = stack.removeLast()

            val name = viewResourceEntryName(view).orEmpty()

            if ((name == "main_radio" || name == "main_theme_radio") && view is ViewGroup) {

                XposedBridge.log("[OfflineGlass] WEIBO: refreshed navigationSource (was stale=${current == null})")

                navigationSource = view

                suppressNativeWeiboBottomBar(view)

                scheduleNavigationSnapshotRefresh(longArrayOf(0L, 48L, 120L))

                postInvalidateOnAnimation()

                return true

            }

            if (view is ViewGroup) {

                for (i in 0 until view.childCount) {

                    stack.add(view.getChildAt(i))

                }

            }

        }

        return false

    }



