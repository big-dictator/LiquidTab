    }



    private fun ViewGroup.getChildAtOrNull(index: Int): View? =

        if (index in 0 until childCount) getChildAt(index) else null



    private fun View.ancestorsAreVisible(): Boolean {

        var current: View? = this

        repeat(16) {

            val view = current ?: return true

            if (view.visibility != View.VISIBLE) return false

            current = view.parent as? View

        }

        return true

    }



    /**

     * Never stack MIUI's asynchronous window blur underneath our captured

     * backdrop pipeline. Both are valid alone, but they sample adjacent

     * compositor frames while a feed scrolls and the translucent result reads

     * as a vibrating/doubled background. The module RenderEffect retains the

     * configured blur and liquid refraction; native blur remains the fallback

     * when backdrop capture is explicitly disabled.

     */

    private fun shouldUseNativeBackgroundBlur(): Boolean =

        config.nativeBlur && !config.backdropCapture



    /**

     * JD keeps its full-screen video channel inside MainFrameActivity, so an

     * Activity-name check cannot distinguish it from Home. Detect the stable

     * combination actually present on that page: a screen-sized video surface

     * plus the top video-channel strip. The probe is throttled and bounded.

     */

    private fun updateJdFullscreenVideoState(): Boolean {

        if (context.packageName != JD_PACKAGE) return false

        val now = SystemClock.uptimeMillis()

        if (now - jdLastFullscreenVideoProbeAt < JD_VIDEO_PAGE_PROBE_INTERVAL_MS) {

            return jdFullscreenVideoActive

        }

        jdLastFullscreenVideoProbeAt = now

        val root = rootView as? ViewGroup ?: return jdFullscreenVideoActive

        val rootWidth = root.width.coerceAtLeast(1)

        val rootHeight = root.height.coerceAtLeast(1)

        var hasLargeVideoSurface = false

        var hasTopVideoLabel = false

        var hasSelectedVideoLabel = false

        var channelLabelCount = 0

        var visited = 0

        val stack = ArrayDeque<Pair<View, Int>>()

        stack += root to 0

        while (stack.isNotEmpty() && visited++ < JD_VIDEO_PAGE_MAX_VIEWS) {

            val (view, depth) = stack.removeLast()

            if (view.visibility != View.VISIBLE || view.alpha <= 0.01f) continue

            if (view !== pddPromotionSurfaceView &&

                (view is SurfaceView || view is TextureView) &&

                view.width >= rootWidth * 0.72f && view.height >= rootHeight * 0.55f

            ) {

                hasLargeVideoSurface = true

            }

            if (view is TextView) {

                val label = view.text?.toString()?.trim().orEmpty()

                if (label in JD_VIDEO_CHANNEL_LABELS) {

                    val location = IntArray(2).also(view::getLocationInWindow)

                    if (location[1] + view.height <= rootHeight * 0.22f) {

                        channelLabelCount++

                        if (label == JD_VIDEO_CHANNEL_LABEL) {

                            hasTopVideoLabel = true

                            val description = view.contentDescription?.toString().orEmpty()

                            if (view.isSelected || description.contains("已选中")) {

                                hasSelectedVideoLabel = true

                            }

                        }

                    }

                }

            }

            if (view is ViewGroup && depth < JD_VIDEO_PAGE_MAX_DEPTH) {

                for (index in 0 until view.childCount) {

                    stack += view.getChildAt(index) to (depth + 1)

                }

            }

        }

        val detected = hasLargeVideoSurface && hasTopVideoLabel &&

            (hasSelectedVideoLabel || channelLabelCount >= 3)

        if (detected != jdFullscreenVideoActive) {

            jdFullscreenVideoActive = detected

            removeCallbacks(msgScrollHideRunnable)

            msgScrolledToStop = false

            if (detected) {

                // Same interaction contract as Weibo Message: initially visible,

                // hide after one idle second, show immediately on the next scroll.

                postDelayed(msgScrollHideRunnable, JD_VIDEO_IDLE_HIDE_DELAY_MS)

            }

            postInvalidateOnAnimation()

        }

        return jdFullscreenVideoActive

    }



    private fun currentPageAllowsNavigation(): Boolean {

        if (context.packageName == MI_HOME_PACKAGE) return !isMiHomeDeviceEditMode()

        if (context.packageName == AMAP_PACKAGE) return !isAmapAIChatActive()

        // Douyin: the liquid bar is fully suppressed while the bottom-control
        // lift work is in progress; nothing must occlude the feed.
        if (context.packageName == DOUYIN_PACKAGE) return false

        if (context.packageName == TIEBA_PACKAGE && tiebaSidebarVisible) return false

        if (context.packageName == NETEASE_PACKAGE && isNeteaseSideDrawerOpen()) return false

        if (context.packageName == YOUTUBE_PACKAGE) return youtubeShortsBarVisible()

        if (context.packageName == JD_PACKAGE) {

            // JD's liquid bar is always shown: no auto-hide on any tab,

            // dependency-free of the native nav-shell hidden state, so the

            // glass never disappears behind chrome during H5 (new-products)

            // or native feed scrolling.

            updateJdFullscreenVideoState()

            updateJdBrowseIdleTimer(false)

            return true

        }

        if (context.packageName == WEIBO_PACKAGE) {

            // Use robust TabHost finding �?navigationSource may be stale after

            // Weibo rebuilds the tab bar during tab switches

            val tabHost = findWeiboTabHost()

            val currentTab = runCatching {

                tabHost?.javaClass?.getMethod("getCurrentTab")?.invoke(tabHost) as? Int

            }.getOrNull() ?: run {

                // TabHost not found �?try refreshing navigationSource

                refreshWeiboNavigationSource()

                return true

            }



            if (currentTab == WEIBO_VIDEO_INDEX) {

                weiboCurrentTab = 1

                if (weiboVideoHideTime == 0L) {

                    weiboVideoHideTime = SystemClock.uptimeMillis() + 1500

                }

                if (SystemClock.uptimeMillis() < weiboVideoHideTime) return true

                return false

            } else if (currentTab == WEIBO_MESSAGE_INDEX) {

                weiboCurrentTab = currentTab

                ensureMsgScrollStopHideListener()

                return !msgScrolledToStop

            } else {

                weiboCurrentTab = currentTab

                weiboLastNonVideoTab = currentTab

                weiboLastNonVideoTabStatic = currentTab

                weiboVideoHideTime = 0L

                weiboMsgHideTime = 0L

                weiboMsgPeekUntil = 0L

                if (msgScrolledToStop) {

                    msgScrolledToStop = false

                    removeCallbacks(msgScrollHideRunnable)

                }

                // Auto-sync slider when tab changed away from video

                if (selectedIndex == WEIBO_VIDEO_INDEX || selectedIndex == WEIBO_MESSAGE_INDEX) {

                    selectedIndex = currentTab

                    dragTarget = visualPositionForNavigationIndex(currentTab)

                    positionSpring.snapTo(dragTarget)

                    postInvalidateOnAnimation()

                }

                return true

            }

        }

        // XHS mirrors Weibo's message-tab contract: the bar leaves 1.5s after

        // entering the message tab and returns as a 1.5s peek when system back

        // is pressed, while the page itself stays put. XHS's own selected flags

        // are stale across fragment switches, so the host's committed index is

        // the source of truth (see resolveSelectedFromViewState).

        if (context.packageName == XHS_PACKAGE) {

            if (selectedIndex == XHS_MESSAGE_INDEX) {

                ensureMsgScrollStopHideListener()

                return !msgScrolledToStop

            }

            if (msgScrolledToStop) {

                msgScrolledToStop = false

                removeCallbacks(msgScrollHideRunnable)

            }

            return true

        }

        // Meituan cart/profile: scroll-stop-hide like Weibo message page

        if (context.packageName == MEITUAN_PACKAGE &&

            (selectedIndex == MEITUAN_CART_INDEX || selectedIndex == MEITUAN_PROFILE_INDEX)) {

            ensureMsgScrollStopHideListener()

            return !msgScrolledToStop

        }

        if (context.packageName == MEITUAN_PACKAGE && msgScrolledToStop) {

            msgScrolledToStop = false

            removeCallbacks(msgScrollHideRunnable)

        }

        // Meituan Takeout profile: scroll-stop-hide. The orders tab keeps the

        // bar permanently (user request): hiding it there left the compositor

        // surface's last frame floating over the feed, because the surface

        // visibility never followed the host's hide animation.

        if (context.packageName == MEITUAN_TAKEOUT_PACKAGE &&

            selectedIndex == MEITUAN_TAKEOUT_PROFILE_INDEX

        ) {

            ensureMsgScrollStopHideListener()

            return !msgScrolledToStop

        }

        if (context.packageName == MEITUAN_TAKEOUT_PACKAGE && msgScrolledToStop) {

            msgScrolledToStop = false

            removeCallbacks(msgScrollHideRunnable)

        }

        // Flash Sale follows the same low-overhead contract as Weibo Message:

        // show immediately while the page moves, then leave one second after

        // scrolling becomes idle. Do not resize its compositor surface.

        if (context.packageName == TAOBAO_PACKAGE && selectedIndex == TAOBAO_HOME_INDEX &&

            taobaoFlashSaleChannelActive

        ) {

            ensureMsgScrollStopHideListener()

            return !msgScrolledToStop

        }

        // Taobao message page: hide bar 1s after scrolling stops, show

        // immediately when scrolling starts.

        if (context.packageName == TAOBAO_PACKAGE && selectedIndex == TAOBAO_MESSAGE_INDEX) {

            ensureMsgScrollStopHideListener()

            return !msgScrolledToStop

        }

        // Reset state when leaving message page

        if (context.packageName == TAOBAO_PACKAGE && msgScrolledToStop) {

            msgScrolledToStop = false

            removeCallbacks(msgScrollHideRunnable)

        }

        if (context.packageName != QQ_PACKAGE && context.packageName != WECHAT_PACKAGE) return true

        val now = SystemClock.uptimeMillis()

        if (now - lastPageVisibilityCheck < PAGE_VISIBILITY_INTERVAL_MS) return pageAllowsNavigation

        lastPageVisibilityCheck = now

        val activity = context.findActivity()

        pageAllowsNavigation = when (context.packageName) {

            QQ_PACKAGE -> !containsActiveQqChatFragment(activity) && !hasQqForegroundPageLayer(activity)

            WECHAT_PACKAGE -> !isWeChatMiniProgramPanelVisible(activity)

            else -> true

        }

        return pageAllowsNavigation

    }



    /**

     * Attach a ViewTreeObserver.OnScrollChangedListener once. When any view

     * in the window scrolls while on Taobao/XHS/Weibo message pages, cancel the

     * hide timer and restart it (1s). When the timer fires, hide the bar.

     */

    private fun ensureMsgScrollStopHideListener() {

        if (msgScrollListenerAttached) return

        val root = rootView ?: return

        root.viewTreeObserver.addOnScrollChangedListener {

            val isMessageTab = (context.packageName == TAOBAO_PACKAGE && selectedIndex == TAOBAO_MESSAGE_INDEX) ||

                (context.packageName == XHS_PACKAGE && selectedIndex == XHS_MESSAGE_INDEX) ||

                (context.packageName == WEIBO_PACKAGE && selectedIndex == WEIBO_MESSAGE_INDEX) ||

                (context.packageName == JD_PACKAGE &&

                    (jdFullscreenVideoActive || selectedIndex == JD_HOME_TAB_INDEX ||

                        selectedIndex == JD_BROWSE_TAB_INDEX)) ||

                (context.packageName == MEITUAN_PACKAGE &&

                    (selectedIndex == MEITUAN_CART_INDEX || selectedIndex == MEITUAN_PROFILE_INDEX)) ||

                (context.packageName == MEITUAN_TAKEOUT_PACKAGE &&

                    (selectedIndex == MEITUAN_TAKEOUT_ORDER_INDEX || selectedIndex == MEITUAN_TAKEOUT_PROFILE_INDEX))

            if (isMessageTab) {

                removeCallbacks(msgScrollHideRunnable)

                if (msgScrolledToStop) {

                    msgScrolledToStop = false

                }

                postDelayed(msgScrollHideRunnable,

                    if (context.packageName == MEITUAN_PACKAGE && selectedIndex == MEITUAN_CART_INDEX) 800L

                    else if (context.packageName == MEITUAN_PACKAGE && selectedIndex == MEITUAN_PROFILE_INDEX) 1500L

                    else if (context.packageName == MEITUAN_TAKEOUT_PACKAGE && selectedIndex == MEITUAN_TAKEOUT_ORDER_INDEX) 800L

                    else if (context.packageName == MEITUAN_TAKEOUT_PACKAGE && selectedIndex == MEITUAN_TAKEOUT_PROFILE_INDEX) 1500L

                    else 1000L)

            }

        }

        // Track touch state: don't hide while user is dragging

        root.setOnTouchListener { _, event ->

            msgUserTouching = event.actionMasked != android.view.MotionEvent.ACTION_UP &&

                event.actionMasked != android.view.MotionEvent.ACTION_CANCEL

            false

        }

        msgScrollListenerAttached = true

    }



