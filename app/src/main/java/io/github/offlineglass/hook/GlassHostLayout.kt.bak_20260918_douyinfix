        // visible for its internal presenter lifecycle. GONE makes the process

        // restart a few seconds after launch. Keep the tree alive but collapse

        // only its reserved footprint; the conditional write avoids doing any

        // work until JD itself explicitly restores the native height.

        val barParams = bar.layoutParams ?: return

        if (!jdBarBaseHeights.containsKey(bar)) jdBarBaseHeights[bar] = barParams.height

        if (barParams.height != 1) {

            barParams.height = 1

            bar.layoutParams = barParams

