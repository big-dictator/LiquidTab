        // of the screen. The content-area container spans the full screen

        // (top=0), so it is excluded. The bottom-bar container and its

        // immediate wrappers have their top edge well below mid-screen.

        val screenHeight = (rootView as? ViewGroup)?.height ?: return

        val topThreshold = screenHeight / 2

        var ancestor = source.parent as? ViewGroup

        var hops = 0

        while (ancestor != null && ancestor !is GlassHostLayout && hops < 6) {

            val loc = IntArray(2)

            ancestor.getLocationOnScreen(loc)

