        // MainFrameContainerView. Never clear that parent's background: its

        // WebView pages restore the surface every frame and would fight us,

        // producing full-page flashes.

        val frame = source.parent as? ViewGroup ?: return

        if (!frame.javaClass.name.endsWith(".MainFrameContainerView")) return



        // Validate cached pddMainContent is still attached and in the frame

        val cached = pddMainContent

        if (cached != null && (!cached.isAttachedToWindow || cached.parent !== frame)) {

            pddMainContent = null

            pddOriginalMainHeight = 0

            pddOriginalMainBottomMargin = 0

            pddChatInsetRemoved = false

        }



        for (index in 0 until frame.childCount) {

            val sibling = frame.getChildAt(index)

            if (sibling === source || sibling === this) continue

            val fullWidth = sibling.width >= frame.width * 0.95f

            val divider = sibling.javaClass == View::class.java && fullWidth &&

                sibling.height in 1..(2f * density).roundToInt().coerceAtLeast(1) &&

                sibling.top in (source.top - sibling.height)..(source.bottom)

