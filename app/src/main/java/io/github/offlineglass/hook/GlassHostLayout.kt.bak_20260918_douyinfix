     * The cart's floating back-to-top square rides above the checkout strip;

     * once the strip was lifted the button stayed at its native anchor and

     * ended up covered. Per the design spec it is re-anchored just above the

     * LIFTED strip's top, keeping a safe gap. Both rects are measured live

     * every frame and the strip is corrected first, so RN re-renders that

     * reset either view are re-corrected before the next draw.

     */

    private fun correctJdBackToTopButton() {

        val bar = jdCheckoutBar?.get() ?: return

        var found = jdBackToTopButton?.get()

        if (found == null || !found.isAttachedToWindow || found.parent == null) {

            val now = SystemClock.uptimeMillis()

            if (now - jdLastBackToTopFind < 200L) return

            jdLastBackToTopFind = now

            jdBackToTopButton = null

            val root = rootView as? ViewGroup ?: return

            if (root.width <= 0 || root.height <= 0) return

            found = findJdBackToTopButton(root, root.width, root.height) ?: return

            jdBackToTopButton = java.lang.ref.WeakReference(found)

        }

        if (found == null) return

        val barLocation = IntArray(2).also(bar::getLocationInWindow)

        val targetBottom = barLocation[1] - JD_BACK_TO_TOP_GAP_PX

        val location = IntArray(2).also(found::getLocationInWindow)

        val delta = location[1] + found.height - targetBottom

        if (kotlin.math.abs(delta) <= 4) return

        found.offsetTopAndBottom(-delta)

        jdBackToTopOffsets[found] = (jdBackToTopOffsets[found] ?: 0) - delta

    }



    /**

     * JD "秒�? (flash delivery) sub-page: two fixed half-width overlays sit

     * flush with the screen bottom �?a coupon strip on the left (596x233 at

     * [14,2423]) and a cart control on the right (596x231 at [610,2425]).

     * Unlike the cart page's full-width strip they are NOT full-width, so the

     * checkout-bar detector never sees them. Same lift recipe as the cart

     * page: re-pin each control's bottom just above the glass top

     * (JD_CHECKOUT_BOTTOM_GAP_PX), moved via offsetTopAndBottom so touch

     * regions follow, re-corrected every probe pass.

     */

    private fun liftJdFlashControls(root: ViewGroup, rootHeight: Int) {

        val rootWidth = root.width

        if (rootWidth <= 0 || rootHeight <= 0) return

        var banner = jdFlashBanner?.get()

        if (banner != null && (!banner.isAttachedToWindow || banner.parent == null)) banner = null

        if (banner == null) jdFlashBanner = null

        var cart = jdFlashCart?.get()

        if (cart != null && (!cart.isAttachedToWindow || cart.parent == null)) cart = null

        if (cart == null) jdFlashCart = null

        if (banner == null || cart == null) {

            val now = SystemClock.uptimeMillis()

            if (now < jdNextFlashFindAt) {

                // Backoff window: whatever is still alive keeps correcting.

                if (banner != null || cart != null) correctJdFlashControls()

                return

            }

            val (foundBanner, foundCart) = findJdFlashBottomControls(root, rootWidth, rootHeight)

            if (foundBanner != null) {

                jdFlashBanner = java.lang.ref.WeakReference(foundBanner)

                banner = foundBanner

            }

            if (foundCart != null) {

                jdFlashCart = java.lang.ref.WeakReference(foundCart)

                cart = foundCart

            }

            // Either control may appear later than the other (the banner can

            // also be dismissed by its X button), so a partial miss retries

            // sooner than a total miss. A total miss must stay a bounded

            // backoff, NOT a permanent lock: switching home channels (秒�?�?

            // 新品) reuses the same NavigationGroup, so nothing would ever

            // reset a permanent flag and the flash-page lift would die until

            // a full tab switch. The scan itself is read-only and prunes the

            // feed's RecyclerView/ViewPager, so it cannot disturb the

            // new-product channel's feed refresh.

            jdNextFlashFindAt = if (foundBanner != null || foundCart != null) {

                now + 600L

            } else {

                now + 1_200L

            }

            if (banner == null && cart == null) return

        }

        correctJdFlashControls()

    }



    /**

     * Layered anchoring, mirroring the cart page's strip + back-to-top pair:

     * the coupon banner's bottom pins just above the glass top, and the

     * floating cart then pins JD_BACK_TO_TOP_GAP_PX above the LIFTED banner's

     * top �?otherwise the full-width banner covers the cart's lower half.

     * With the banner dismissed (its X button), the cart falls back to the

     * banner slot itself.

     */

    private fun correctJdFlashControls() {

        val rootHeight = (rootView as? View)?.height ?: return

        if (rootHeight <= 0 || width <= 0 || height <= 0) return

        val hostLocation = IntArray(2).also(::getLocationInWindow)

        val safeBottom = hostLocation[1] - JD_CHECKOUT_BOTTOM_GAP_PX

        val banner = jdFlashBanner?.get()

        var bannerTop = Int.MIN_VALUE

        if (banner != null && banner.isAttachedToWindow && banner.parent != null) {

            val location = IntArray(2).also(banner::getLocationInWindow)

            val delta = location[1] + banner.height - safeBottom

            if (kotlin.math.abs(delta) > 1) {

                jdFlashControlBaseTranslations.putIfAbsent(banner, banner.translationY)

                banner.translationY -= delta.toFloat()

                android.util.Log.i(

                    "JdGlassDiag",

                    "JdFlash translate banner ${banner.javaClass.simpleName} h=${banner.height} " +

                        "fromBottom=${location[1] + banner.height} target=$safeBottom delta=$delta",

                )

            }

            val settled = IntArray(2).also(banner::getLocationInWindow)

            bannerTop = settled[1]

        }

        val cart = jdFlashCart?.get() ?: return

        if (!cart.isAttachedToWindow || cart.parent == null) return

        val targetBottom =

            if (bannerTop != Int.MIN_VALUE) bannerTop - JD_BACK_TO_TOP_GAP_PX else safeBottom

        val location = IntArray(2).also(cart::getLocationInWindow)

        val delta = location[1] + cart.height - targetBottom

        if (kotlin.math.abs(delta) > 1) {

            jdFlashControlBaseTranslations.putIfAbsent(cart, cart.translationY)

            cart.translationY -= delta.toFloat()

            android.util.Log.i(

                "JdGlassDiag",

                "JdFlash translate cart ${cart.javaClass.simpleName} h=${cart.height} " +

                    "fromBottom=${location[1] + cart.height} target=$targetBottom delta=$delta",

            )

        }

    }



    /**

     * The flash ("秒�?) page's two floating controls, identified from a live

     * view-tree dump:

     *

     *  - Coupon banner: `HourlyGoScreenBottomBarView` [0,2586 1220x117] �?

     *    full-width strip pinned at the screen bottom (bottom edge runs 47 px

     *    offscreen), hosting the coupon copy and the 去使�?button. It sits as

     *    a direct child of HourlyGoMvpFragmentView, OUTSIDE the feed's

     *    RecyclerView. Matched by class name (JD-private, unambiguous) with a

     *    full-width bottom-strip shape fallback.

     *

     *  - Floating cart: a 130x130 SimpleDraweeView at (1064,2378) inside a

     *    130x143 ConstraintLayout �?the square right-edge FAB, half-covered

     *    by the glass. Matched as a near-square right-edge image button

     *    outside every scroll container; its direct parent container is what

     *    gets lifted (keeps the badge and touch area together).

     */

    private fun findJdFlashBottomControls(root: ViewGroup, rootWidth: Int, rootHeight: Int): Pair<View?, View?> {

        val stack = ArrayDeque<View>()

        stack += root

        var visited = 0

        var banner: View? = null

        var bannerBottom = -1

        var cart: View? = null

        var cartBottom = -1

        val loc = IntArray(2)

        while (stack.isNotEmpty() && visited++ < 1200) {

            val view = stack.removeLast()

            if (view === this || view is GlassHostLayout ||

                view is TiebaBottomBlurOverlay || view is BilibiliBottomVeil

            ) continue

            val name = view.javaClass.simpleName

            // Prune the feed's subtrees: the staggered-grid RecyclerView and

            // the inner pagers hold hundreds of TNViewGroup items and would

            // exhaust the visit budget before the floating controls (which

            // sit OUTSIDE them, as direct children of the fragment view) are

            // ever reached.

            if (view is ViewGroup &&

                (name.contains("RecyclerView") || name.contains("ViewPager"))

            ) continue

            if (view.visibility != View.VISIBLE || view.alpha <= 0.05f) continue

            if (view is ViewGroup) {

                if (name == "HourlyGoScreenBottomBarView" &&

                    view.width >= rootWidth * 0.98f && view.height in 80..200

                ) {

                    view.getLocationInWindow(loc)

                    val bottom = loc[1] + view.height

                    if (bottom > bannerBottom && !isInsideScrollContainer(view)) {

                        banner = view

                        bannerBottom = bottom

                    }

                    // Do not descend into the banner: its inner TN wrappers

                    // share the strip shape.

                    continue

                }

                for (index in view.childCount - 1 downTo 0) {

                    stack += view.getChildAt(index)

                }

            }

            // Floating cart FAB: near-square image view (90�?80 px) hugging

            // the right edge in the lower half, outside scroll containers.

            // Its parent container (the FAB's hit area) is lifted instead.

            if (view is android.widget.ImageView && view.width in 90..180 &&

                view.height in 90..180 &&

                kotlin.math.abs(view.width - view.height) <= 28

            ) {

                view.getLocationInWindow(loc)

                val right = loc[0] + view.width

                val bottom = loc[1] + view.height

                if (right >= rootWidth - 220 && bottom >= rootHeight * 0.55f &&

                    bottom <= rootHeight + 60 &&

                    !isInsideScrollContainer(view) && !isInsideRecyclerOrPager(view)

                ) {

                    val parent = view.parent as? ViewGroup

                    if (parent != null && parent.width in 90..220 && parent.height in 90..220) {

                        parent.getLocationInWindow(loc)

                        val parentBottom = loc[1] + parent.height

                        if (parentBottom > cartBottom) {

                            cart = parent

                            cartBottom = parentBottom

                        }

                    }

                }

            }

        }

        val sb = StringBuilder(

            "JdFlash find: root=${rootWidth}x$rootHeight banner=" +

                (banner?.let { b ->

                    b.getLocationInWindow(loc)

                    "${b.javaClass.simpleName} h=${b.height} y=${loc[1]}"

                } ?: "null") +

                " cart=" +

                (cart?.let { c ->

                    c.getLocationInWindow(loc)

                    "${c.javaClass.simpleName} h=${c.height} y=${loc[1]}"

                } ?: "null"),

        )

        android.util.Log.i("JdGlassDiag", sb.toString())

        return banner to cart

    }



    /**

     * Structural signature of the cart's floating back-to-top control: a

     * near-square ViewGroup (90�?80 px, width≈height) hugging the right edge,

     * in the lower half of the window, outside every scroll container. Feed

     * cards are 1161 px wide, thumbnails live inside the scroll view, and the

     * checkout strip is full-width �?none of them match.

     */

    private fun findJdBackToTopButton(root: ViewGroup, rootWidth: Int, rootHeight: Int): View? {

        val stack = ArrayDeque<View>()

        stack += root

        var visited = 0

        var best: View? = null

        var bestBottom = -1

        while (stack.isNotEmpty() && visited++ < 900) {

            val view = stack.removeLast()

            if (view === this || view is GlassHostLayout ||

                view is TiebaBottomBlurOverlay || view is BilibiliBottomVeil

            ) continue

            if (view.visibility != View.VISIBLE || view.alpha <= 0.05f) continue

            // Same cheap-first ordering: geometry only for near-square

            // candidates that already pass the size checks.

            val squareish = view is ViewGroup && view.width in 90..180 &&

                view.height in 90..180 &&

                kotlin.math.abs(view.width - view.height) <= 24

            if (squareish) {

                val location = IntArray(2).also(view::getLocationInWindow)

                val right = location[0] + view.width

                val bottom = location[1] + view.height

                if (right >= rootWidth - 80 && bottom >= rootHeight * 0.5f &&

                    !isInsideScrollContainer(view) && bottom > bestBottom

                ) {

                    best = view

                    bestBottom = bottom

                }

                for (index in view.childCount - 1 downTo 0) stack += view.getChildAt(index)

            } else if (view is ViewGroup) {

                for (index in view.childCount - 1 downTo 0) stack += view.getChildAt(index)

            }

        }

        return best

    }



    private fun restoreJdContentSizes() {

        jdBackToTopOffsets.forEach { (view, applied) ->

            if (applied != 0 && view.isAttachedToWindow) view.offsetTopAndBottom(-applied)

        }

        jdBackToTopOffsets.clear()

        jdBackToTopButton = null

        jdLastBackToTopFind = 0L

        jdCheckoutOffsets.forEach { (view, applied) ->

            if (applied != 0 && view.isAttachedToWindow) view.offsetTopAndBottom(-applied)

        }

        jdCheckoutOffsets.clear()

        jdFlashControlBaseTranslations.forEach { (view, base) ->

            if (view.isAttachedToWindow && kotlin.math.abs(view.translationY - base) > 0.5f) {

                view.translationY = base

            }

        }

        jdFlashControlBaseTranslations.clear()

        jdFlashBanner = null

        jdFlashCart = null

        jdNextFlashFindAt = 0L

        jdCheckoutDiscoveryExhausted = false

        jdContentAdjustedSource = null

        jdDecorClearedSource = null

        jdCollapsedBar = null

        jdContentWantedHeights.clear()

        jdBarBaseHeights.forEach { (view, base) ->

            val params = view.layoutParams ?: return@forEach

            if (params.height != base) {

                params.height = base

                view.layoutParams = params

            }

        }

        jdBarBaseHeights.clear()

        jdContentBaseHeights.forEach { (view, base) ->

            val params = view.layoutParams ?: return@forEach

            if (params.height != base) {

                params.height = base

                view.layoutParams = params

            }

        }

        jdContentBaseHeights.clear()

    }



    /**

     * Weibo recreates its navigation hierarchy while a page is settling.  The

     * source row is therefore used only as a controller and badge provider;

     * copying any of its artwork allows feed cards, avatar strips and Weibo's

     * blue selected disk to leak into the retained bitmap after repeated drags.

     */

    private fun captureNormalizedWeiboNavigation(source: ViewGroup, target: Bitmap): Boolean {

        if (source.width <= 0 || source.height <= 0) return false

        for (index in weiboBadgeTexts.indices) weiboBadgeTexts[index] = null

        val sourceLocation = IntArray(2).also(source::getLocationOnScreen)

        val stack = ArrayDeque<View>()

        stack.add(source)

        while (stack.isNotEmpty()) {

            val view = stack.removeLast()

            if (view is ViewGroup) {

                for (index in 0 until view.childCount) stack.add(view.getChildAt(index))

            }

            if (view !== source && view is TextView && view.visibility == View.VISIBLE &&

                view.width in 1..(54f * density).roundToInt() &&

                view.height in 1..(42f * density).roundToInt()

            ) {

                val badgeText = view.text?.toString()?.trim().orEmpty()

                if (badgeText.matches(WEIBO_BADGE_PATTERN)) {

                    val location = IntArray(2).also(view::getLocationOnScreen)

                    val localCenterX = location[0] - sourceLocation[0] + view.width / 2f

                    val localCenterY = location[1] - sourceLocation[1] + view.height / 2f

                    if (localCenterX in 0f..source.width.toFloat() &&

                        localCenterY in 0f..source.height.toFloat()

                    ) {

                        val index = floor(localCenterX / source.width * WEIBO_NAV_LABELS.size)

                            .toInt().coerceIn(0, WEIBO_NAV_LABELS.lastIndex)

                        weiboBadgeTexts[index] = badgeText

                    }

                }

            }

        }

        Canvas(target).drawColor(Color.TRANSPARENT, BlendMode.CLEAR)

        return true

    }



