     * (its tree, click callbacks and selected states stay intact �?the host

     * forwards taps via performClick), then walk the main content spine and

     * extend every near-full-height container that JD shrank from the bottom.

     * The feed then draws under the liquid glass down to the window bottom.

     * Idempotent; every preDraw cheaply verifies the collapse and the extended

     * heights are still in effect and re-runs when JD's page switches undo

     * them. Original heights are kept for restore on detach.

     */

    private fun adjustJdContentFullscreen() {

        if (context.packageName != JD_PACKAGE) return

        val source = navigationSource?.takeIf { it.isAttachedToWindow } ?: return

        val root = rootView as? ViewGroup ?: return

        val rootHeight = root.height

        if (rootHeight <= 0) return

