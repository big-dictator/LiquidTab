    /**

     * WeChat's native tab icons cannot be captured via View.draw() (produces

     * empty bitmap). Instead, walk the source's view tree and directly draw

     * each tab's icon Drawable, text label, and notification badge.

     *

     * Source structure: LauncherUIBottomTabView �?LinearLayout �?N × RelativeLayout

     *   Each RelativeLayout: LinearLayout(label area) + RelativeLayout(icon area)

     *     Icon area: TabIconView(icon 85×85) + ImageView(badge dot) + TextView(badge count)

     *

     * Text disappearing fix: draw text directly via canvas.drawText() instead of

     * labelView.draw(), avoiding parent alpha=0 interference.

     *

     * Badge fix: detect badge views (ImageView dot + TextView count) and draw

     * them when they are VISIBLE (WeChat sets them VISIBLE on unread messages).

     */

    private fun drawWeChatNativeTabs(canvas: Canvas, source: ViewGroup) {

        val inner = (0 until source.childCount)

            .map { source.getChildAt(it) }

            .filterIsInstance<ViewGroup>()

            .firstOrNull { it.childCount >= 3 }

            ?: return

        val tabCount = inner.childCount

        if (tabCount <= 0) return



        // Use cached tab references or rebuild cache

        val tabs = weChatCachedTabs?.takeIf {

            weChatTabsCacheSource === source && it.size == tabCount &&

                it.all { tc -> tc.tab.isAttachedToWindow }

        } ?: buildList {

            for (i in 0 until tabCount) {

                val tab = inner.getChildAt(i) as? ViewGroup ?: continue

                var iconView: View? = null

                var labelView: TextView? = null

                var badgeDot: ImageView? = null

                var badgeCount: TextView? = null

                val stack = ArrayDeque<View>()

                stack += tab

                while (stack.isNotEmpty()) {

                    val v = stack.removeLast()

                    val name = v.javaClass.simpleName

                    when {

                        name == "TabIconView" -> iconView = v

                        name == "ImageView" -> if (badgeDot == null) badgeDot = v as? ImageView

                        v is TextView -> {

                            if (labelView == null) labelView = v

                            else if (badgeCount == null) badgeCount = v as? TextView

                        }

                    }

                    if (v is ViewGroup) {

                        for (j in 0 until v.childCount) stack += v.getChildAt(j)

                    }

                }

                add(WeChatTabViews(iconView, labelView, badgeDot, badgeCount, tab))

            }

        }.also {

            weChatCachedTabs = it

            weChatTabsCacheSource = source

        }



        // slotTransform already centers source content within the pill.

        // We draw in source coordinate space. The pill height in source

        // coordinates is height / slotTransform.scale. Use that to

        // vertically center icon + spacing + text within the pill.

        val firstIcon = tabs.firstOrNull { it.icon != null }?.icon

        val iconSize = firstIcon?.width?.toFloat() ?: (40f * density)

        val labelH = tabs.firstOrNull { it.label != null }?.label?.let {

            val tp = android.text.TextPaint(it.paint)

            tp.descent() - tp.ascent()

        } ?: (12f * density)

        val gap = 3f * density

        val totalH = iconSize + gap + labelH

        // pillHeight in source coords = height / slotTransform.scale

        val pillH = source.height.toFloat()

        val baseY = (pillH - totalH) * 0.5f

        val iconCenterY = baseY + iconSize * 0.5f

        val textCenterY = baseY + iconSize + gap + labelH * 0.5f



        val tabWidth = source.width.toFloat() / tabCount



        for ((idx, tc) in tabs.withIndex()) {

            // Center each tab horizontally within its slot

            val centerX = (idx + 0.5f) * tabWidth



            // Draw icon centered at (centerX, iconCenterY)

            val icon = tc.icon

            if (icon != null && icon.width > 0 && icon.height > 0) {

                val iW = icon.width.toFloat()

                val iH = icon.height.toFloat()

                val tx = centerX - iW * 0.5f

                val ty = iconCenterY - iH * 0.5f

                canvas.save()

                canvas.translate(tx, ty)

                // Enlarge icons to 1.15x around their own centre; text and

                // notification badge keep their original size and position.

                canvas.scale(1.15f, 1.15f, iW * 0.5f, iH * 0.5f)

                val savedAlpha = icon.alpha

                icon.alpha = 1f

                icon.visibility = View.VISIBLE

                icon.draw(canvas)

                icon.alpha = savedAlpha

                canvas.restore()



                // Draw label text centered below icon

                val label = tc.label

                if (label != null) {

                    val text = label.text

                    if (text != null && text.isNotEmpty()) {

                        val tp = android.text.TextPaint(label.paint)

                        tp.color = label.currentTextColor

                        tp.alpha = 255

                        val s = text.toString()

                        val tw = tp.measureText(s)

                        val lx = centerX - tw * 0.5f

                        val ly = textCenterY + (tp.descent() - tp.ascent()) * 0.5f - tp.descent()

                        canvas.drawText(s, lx, ly, tp)

                    }

                }



                // Draw notification badge if unread messages exist

                val cnt = tc.badgeCount

                if (cnt != null && cnt.visibility == View.VISIBLE) {

                    val text = cnt.text

                    if (text != null && text.isNotEmpty()) {

                        val br = 9f * density

                        val bx = centerX + iW * 0.5f - 4f * density

                        // Badge top edge slightly below pill top edge

                        val by = iconCenterY - iH * 0.1875f

                        val bp = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)

                        bp.color = android.graphics.Color.RED

                        canvas.drawCircle(bx, by, br, bp)

                        val cp = android.text.TextPaint(android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG))

                        cp.color = android.graphics.Color.WHITE

                        cp.textSize = cnt.textSize.toFloat()

                        cp.isFakeBoldText = true

                        val cs = text.toString()

                        val cw = cp.measureText(cs)

                        val cx = bx - cw * 0.5f

                        val cy = by + (cp.descent() - cp.ascent()) * 0.5f - cp.descent()

                        canvas.drawText(cs, cx, cy, cp)

                    }

                }

            }

        }

    }



    private fun drawNavigationContent(canvas: Canvas, extraScale: Float, tintBySelection: Boolean) {

        val source = navigationSource?.takeIf { it.width > 0 && it.height > 0 }

        // For WeChat: source.draw() cannot capture native tab icons via snapshot

        // (produces empty bitmap). Always draw directly from source with alpha=1.

        val snapshot = when {

            context.packageName == WECHAT_PACKAGE -> null

            context.packageName == TAOBAO_PACKAGE && taobaoFlashChannelActive ->

                taobaoStableNavigationSnapshot?.takeUnless(Bitmap::isRecycled)

                    ?: navigationSnapshot?.takeUnless(Bitmap::isRecycled)

            else -> navigationSnapshot?.takeUnless(Bitmap::isRecycled)

        }

        if (snapshot == null && source == null) return

        val sourceWidth = snapshot?.width ?: source!!.width

        val sourceHeight = snapshot?.height ?: source!!.height

        val firstEnabled = enabledNavigationIndices().firstOrNull() ?: return

        val transform = sourceTransformForSlot(sourceWidth, sourceHeight, firstEnabled, 0)

        val projectionCompensation = when (context.packageName) {

            QQ_PACKAGE -> (QQ_TARGET_ICON_DP / QQ_NATIVE_ICON_DP) * config.iconScale /

                transform.scale.coerceAtLeast(0.0001f)

            WECHAT_PACKAGE -> config.iconScale / transform.scale.coerceAtLeast(0.0001f)

            MEITUAN_PACKAGE, MEITUAN_TAKEOUT_PACKAGE -> config.iconScale / transform.scale.coerceAtLeast(0.0001f)

            TIEBA_PACKAGE -> (config.iconScale * TIEBA_CONTENT_SCALE) /

                transform.scale.coerceAtLeast(0.0001f)

            else -> 1f

        }

        val finalScale = projectionCompensation * extraScale



        if (canvas.isHardwareAccelerated && context.packageName != WECHAT_PACKAGE) {

            if (snapshot != null) {

                if (snapshot !== navigationContentRecordedBitmap ||

                    sourceWidth != navigationContentRecordedWidth ||

                    sourceHeight != navigationContentRecordedHeight

                ) {

                    val navigationCanvas = navigationContentNode.beginRecording(sourceWidth, sourceHeight)

                    navigationCanvas.drawBitmap(snapshot, 0f, 0f, navigationPaint)

                    navigationContentNode.endRecording()

                    navigationContentNode.setPosition(0, 0, sourceWidth, sourceHeight)

                    navigationContentRecordedBitmap = snapshot

                    navigationContentRecordedWidth = sourceWidth

                    navigationContentRecordedHeight = sourceHeight

                }

            } else {

                val navigationCanvas = navigationContentNode.beginRecording(sourceWidth, sourceHeight)

                val src = source!!

                val saved = src.alpha; if (saved < 0.01f) src.alpha = 1f

                src.draw(navigationCanvas)

                if (saved < 0.01f) src.alpha = saved

                navigationContentNode.endRecording()

                navigationContentNode.setPosition(0, 0, sourceWidth, sourceHeight)

                navigationContentRecordedBitmap = null

            }

        }



        val slotWidth = tabWidthPx()

        val horizontalPadding = 4f * density

        val dark = isDarkGlass()

        for ((visualIndex, index) in enabledNavigationIndices().withIndex()) {

            val slotTransform = sourceTransformForSlot(

                sourceWidth,

                sourceHeight,

                index,

                visualIndex,

            )

            val left = horizontalPadding + visualIndex * slotWidth

            val right = left + slotWidth

            val centerX = (left + right) / 2f

            canvas.save()

            canvas.clipRect(left, 0f, right, height.toFloat())

            if (context.packageName == TAOBAO_PACKAGE &&

                (index != TAOBAO_HOME_INDEX || selectedIndex != TAOBAO_HOME_INDEX) &&

                drawFixedTaobaoTabSlot(

                    canvas = canvas,

                    index = index,

                    centerX = centerX,

                    centerY = height / 2f +

                        (slotTransform.dy + sourceHeight * slotTransform.scale / 2f - height / 2f) *

                        finalScale,

                    boxSize = min(sourceWidth / 5f, sourceHeight.toFloat()) *

                        slotTransform.scale * finalScale,

                )

            ) {

                // Stable artwork lives in glass coordinates and is never

                // sourced from Taobao's asynchronously recycled tab Views.

                // Hidden native slots remain the click/selection targets.

                canvas.restore()

                continue

            }

            val tintLayer = if (tintBySelection) {

                val tint = if (index == selectedIndex) {

                    selectedNavigationAccent()

                } else if (dark) {

                    Color.WHITE

                } else {

                    Color.BLACK

                }

                navigationPaint.colorFilter = BlendModeColorFilter(tint, BlendMode.SRC_IN)

                navigationPaint.alpha = if (index == selectedIndex) 255 else 235

                canvas.saveLayer(left, 0f, right, height.toFloat(), navigationPaint)

            } else {

                -1

            }

            canvas.scale(finalScale, finalScale, centerX, height / 2f)

            // Meituan centre tab: center icon, hide label

            if (context.packageName == MEITUAN_PACKAGE && index == 2) {

                canvas.translate(0f, height * 0.13f - 2f)

                canvas.clipRect(left, 0f, right, height * 0.7f)

            } else if (context.packageName == MEITUAN_PACKAGE) {

                canvas.translate(0f, -6f * density)

            }

            val contentOffsetY = when (context.packageName) {

                WEIBO_PACKAGE -> WEIBO_CONTENT_OFFSET_DP * density

                JD_PACKAGE -> JD_CONTENT_OFFSET_DP * density

                TAOBAO_PACKAGE -> if (index == TAOBAO_HOME_INDEX &&

                    selectedIndex == TAOBAO_HOME_INDEX &&

                    taobaoSelectedHomeContentCenterY.isFinite()

                ) {

                    height / 2f -

                        (slotTransform.dy + taobaoSelectedHomeContentCenterY * slotTransform.scale)

                } else {

                    0f

                }

                else -> 0f

            }

            canvas.translate(slotTransform.dx, slotTransform.dy + contentOffsetY)

            canvas.scale(slotTransform.scale, slotTransform.scale)

            if (context.packageName == WECHAT_PACKAGE) {

                // WeChat: draw native tabs directly (source.draw() doesn't work)

                drawWeChatNativeTabs(canvas, source!!)

            } else if (canvas.isHardwareAccelerated) {

                canvas.drawRenderNode(navigationContentNode)

            } else if (snapshot != null) {

                canvas.drawBitmap(snapshot, 0f, 0f, navigationPaint)

            } else {

                val src = source!!

                val saved = src.alpha; if (saved < 0.01f) src.alpha = 1f

                src.draw(canvas)

                if (saved < 0.01f) src.alpha = saved

            }

            if (tintLayer >= 0) canvas.restoreToCount(tintLayer)

            canvas.restore()

        }

        navigationPaint.colorFilter = null

        navigationPaint.alpha = 255

    }



    /** Paint Taobao's own default icon + label into one stable slot. */

    private fun drawFixedTaobaoTabSlot(

        canvas: Canvas,

        index: Int,

        centerX: Float,

        centerY: Float,

        boxSize: Float,

    ): Boolean {

        val artwork = loadTaobaoFixedTabArtwork(index) ?: return false

        if (artwork.width <= 0 || artwork.height <= 0 || boxSize <= 0f) return false

        val color = if (selectedIndex == index) {

            TAOBAO_ACCENT_COLOR

        } else if (isDarkGlass()) {

            TAOBAO_UNSELECTED_DARK_COLOR

        } else {

            TAOBAO_UNSELECTED_LIGHT_COLOR

        }

        val half = boxSize / 2f

        val destination = RectF(

            centerX - half,

            centerY - half,

            centerX + half,

            centerY + half,

        )

        snapshotCopyPaint.alpha = 255

        snapshotCopyPaint.colorFilter = BlendModeColorFilter(color, BlendMode.SRC_IN)

        canvas.drawBitmap(artwork, null, destination, snapshotCopyPaint)

        snapshotCopyPaint.colorFilter = null

        return true

    }



    private fun taobaoBadgeView(): TextView? {

        val source = navigationSource ?: return null

        val messageRoot = source.getChildAtOrNull(TAOBAO_MESSAGE_INDEX) ?: return null

        val stack = ArrayDeque<Pair<View, Int>>()

        stack += messageRoot to 0

        var best: TextView? = null

        while (stack.isNotEmpty()) {

            val (view, depth) = stack.removeLast()

            if (view is TextView) {

                val text = view.text?.toString()?.trim().orEmpty()

                if (text.matches(Regex("\\d{1,3}\\+?")) && view.width > 0 && view.height > 0) {

                    if (best == null || view.width * view.height < best!!.width * best!!.height) best = view

                }

            }

            if (view is ViewGroup && depth < 6) {

                for (index in view.childCount - 1 downTo 0) stack += view.getChildAt(index) to (depth + 1)

            }

        }

        return best

    }



    private fun taobaoBadgeSourceRect(source: ViewGroup): RectF? {

        val badge = taobaoBadgeView() ?: return null

        val sourceLocation = IntArray(2).also(source::getLocationInWindow)

        val badgeLocation = IntArray(2).also(badge::getLocationInWindow)

        val inset = 1.5f * density / sourceTransform(source).scale

        return RectF(

            badgeLocation[0] - sourceLocation[0] - inset,

            badgeLocation[1] - sourceLocation[1] - inset,

            badgeLocation[0] - sourceLocation[0] + badge.width + inset,

            badgeLocation[1] - sourceLocation[1] + badge.height + inset,

        )

    }



    private fun drawTaobaoBadgeOverlay(canvas: Canvas, contentScale: Float) {

        val source = navigationSource?.takeIf { it.width > 0 && it.height > 0 } ?: return

        if (isNavigationEntryDisabled(TAOBAO_MESSAGE_INDEX)) return

        val badge = taobaoBadgeView() ?: return

        val localRect = taobaoBadgeSourceRect(source) ?: return

        val visualIndex = enabledNavigationIndices().indexOf(TAOBAO_MESSAGE_INDEX)

        if (visualIndex < 0) return

        val transform = sourceTransformForSlot(

            source.width,

            source.height,

            TAOBAO_MESSAGE_INDEX,

            visualIndex,

        )

        val centerX = transform.dx + localRect.centerX() * transform.scale

        val centerY = transform.dy + localRect.centerY() * transform.scale

        val nativeWidth = (localRect.width() - 3f * density / transform.scale).coerceAtLeast(1f)

        val nativeHeight = (localRect.height() - 3f * density / transform.scale).coerceAtLeast(1f)

        val halfWidth = max(nativeWidth * transform.scale / 2f, 8.5f * density)

        val halfHeight = max(nativeHeight * transform.scale / 2f, 8.5f * density)

        val badgeRect = RectF(centerX - halfWidth, centerY - halfHeight, centerX + halfWidth, centerY + halfHeight)

        val saved = canvas.save()

        canvas.scale(

            contentScale.coerceAtLeast(0.01f),

            contentScale.coerceAtLeast(0.01f),

            centerX,

            height / 2f,

        )

        canvas.drawRoundRect(badgeRect, halfHeight, halfHeight, taobaoBadgePaint)

        taobaoBadgeTextPaint.textSize = badge.textSize * transform.scale

        val baseline = centerY - (taobaoBadgeTextPaint.ascent() + taobaoBadgeTextPaint.descent()) / 2f

        canvas.drawText(badge.text?.toString().orEmpty(), centerX, baseline, taobaoBadgeTextPaint)

        canvas.restoreToCount(saved)

    }



    /**

     * QQ's unread badge belongs to the native tab child rather than the static

     * icon. Paint that child as the final layer so its original red artwork is

     * never included in the blue selected-icon mask.

     */

    private fun drawQqBadgeOverlay(canvas: Canvas) {

        if (slotCount != 3) return

        val source = navigationSource?.takeIf { it.width > 0 && it.height > 0 } ?: return

        val container = findSlotContainer() ?: return

        val sourceLocation = IntArray(2).also(source::getLocationInWindow)

        for (index in 0 until min(container.childCount, slotCount)) {

            if (isNavigationEntryDisabled(index)) continue

            val visualIndex = enabledNavigationIndices().indexOf(index)

            if (visualIndex < 0) continue

            val transform = sourceTransformForSlot(

                source.width,

                source.height,

                index,

                visualIndex,

            )

            val item = container.getChildAt(index)

            val stack = ArrayDeque<Pair<View, Int>>()

            stack += item to 0

            while (stack.isNotEmpty()) {

                val (candidate, depth) = stack.removeLast()

                if (candidate.javaClass.name == QQ_BADGE_CLASS &&

                    candidate.visibility == View.VISIBLE && candidate.width > 0 && candidate.height > 0

                ) {

                    val badgeLocation = IntArray(2).also(candidate::getLocationInWindow)

                    val centerX = transform.dx +

                        (badgeLocation[0] - sourceLocation[0] + candidate.width / 2f) * transform.scale

                    val centerY = transform.dy +

                        (badgeLocation[1] - sourceLocation[1] + candidate.height / 2f) * transform.scale

                    val badgeScale = max(

                        transform.scale,

                        QQ_BADGE_MIN_HEIGHT_DP * density / candidate.height.coerceAtLeast(1),

                    )

                    val save = canvas.save()

                    canvas.translate(

                        centerX - candidate.width * badgeScale / 2f,

                        centerY - candidate.height * badgeScale / 2f,

                    )

                    canvas.scale(badgeScale, badgeScale)

                    val oldAlpha = candidate.alpha

                    candidate.alpha = 1f

                    candidate.draw(canvas)

                    candidate.alpha = oldAlpha

                    canvas.restoreToCount(save)

                    break

                }

                if (candidate is ViewGroup && depth < 6) {

                    for (childIndex in candidate.childCount - 1 downTo 0) {

                        stack += candidate.getChildAt(childIndex) to (depth + 1)

                    }

                }

            }

        }

    }



    /** Xiaomi Community's five APK vector icons in fixed glass slots. */

    private fun drawMiCommunityNavigation(canvas: Canvas, extraScale: Float) {

        if (slotCount != 5 || width <= 0 || height <= 0) return

        val liveItems = miCommunityNavItems()

        val slotWidth = tabWidthPx()

        val horizontalPadding = 4f * density

        val iconSize = MI_COMMUNITY_ICON_SIZE_DP * density

        val dark = isDarkGlass()

        val selectedColor = if (dark) Color.WHITE else MI_COMMUNITY_SELECTED_LIGHT

        val normalColor = if (dark) MI_COMMUNITY_NORMAL_DARK else MI_COMMUNITY_NORMAL_LIGHT

        val itemScale = config.iconScale * extraScale

        miCommunityLabelPaint.textSize =

            MI_COMMUNITY_LABEL_TEXT_SP * resources.displayMetrics.scaledDensity

        // Build one measured icon-gap-label silhouette and centre that whole

        // group. This mirrors Bilibili while guaranteeing that an enlarged

        // live icon can never consume the label's reserved gap.

        val labelMetrics = miCommunityLabelPaint.fontMetrics

        val labelHeight = labelMetrics.bottom - labelMetrics.top

        val contentGap = MI_COMMUNITY_ICON_LABEL_GAP_DP * density

        val groupHeight = iconSize + contentGap + labelHeight

        // A small optical lift matches the perceived centre used by the

        // Bilibili tabs; keep the measured icon/label geometry intact.

        val groupTop = (height - groupHeight) / 2f - MI_COMMUNITY_CONTENT_LIFT_DP * density

        val iconCenterY = groupTop + iconSize / 2f

        val labelBaseline = groupTop + iconSize + contentGap - labelMetrics.top



        for ((visualIndex, index) in enabledNavigationIndices().withIndex()) {

            val selected = index == selectedIndex

            val centerX = horizontalPadding + (visualIndex + 0.5f) * slotWidth

            val color = if (selected) selectedColor else normalColor

            canvas.save()

            canvas.scale(itemScale, itemScale, centerX, height / 2f)



            val liveIcon = liveItems.getOrNull(index)?.let(::findMiCommunityIconView)

            val drawable = liveIcon?.drawable

            if (drawable != null) {

                // Server-delivered menu artwork can differ from the APK's

                // fallback vectors. Draw that exact ImageView drawable into

                // our fixed slot and tint only its alpha, never its layout.

                // The outer drawable is scaled separately because its nested

                // child keeps an intrinsic size. Pre-compensate its lower edge

                // so the scaled result still ends at the measured icon bound.

                val boxBottom = iconCenterY + iconSize / (2f * MI_COMMUNITY_LIVE_ICON_SCALE)

                val boxSize = MI_COMMUNITY_SOURCE_ICON_BOX_DP * density

                val destination = RectF(

                    centerX - boxSize / 2f,

                    boxBottom - boxSize,

                    centerX + boxSize / 2f,

                    boxBottom,

                )

                val layerPaint = miCommunityIconPaint

                layerPaint.colorFilter = BlendModeColorFilter(color, BlendMode.SRC_IN)

                val layerBounds = RectF(

                    centerX + (destination.left - centerX) * MI_COMMUNITY_LIVE_ICON_SCALE,

                    iconCenterY + (destination.top - iconCenterY) * MI_COMMUNITY_LIVE_ICON_SCALE,

                    centerX + (destination.right - centerX) * MI_COMMUNITY_LIVE_ICON_SCALE,

                    iconCenterY + (destination.bottom - iconCenterY) * MI_COMMUNITY_LIVE_ICON_SCALE,

                )

                val layer = canvas.saveLayer(layerBounds, layerPaint)

                val scaledContent = canvas.save()

                // Some server drawables keep an intrinsic-size child inside

                // their bounds. Scaling only the bounds therefore changes no

                // visible pixels; scale the rendered content itself instead.

                canvas.scale(

                    MI_COMMUNITY_LIVE_ICON_SCALE,

                    MI_COMMUNITY_LIVE_ICON_SCALE,

                    centerX,

                    iconCenterY,

                )

                val oldBounds = Rect(drawable.bounds)

                drawable.bounds = Rect(

                    destination.left.roundToInt(),

                    destination.top.roundToInt(),

                    destination.right.roundToInt(),

                    destination.bottom.roundToInt(),

                )

                drawable.draw(canvas)

                drawable.bounds = oldBounds

                canvas.restoreToCount(scaledContent)

                canvas.restoreToCount(layer)

                layerPaint.colorFilter = null

            } else {

                miCommunityIconPaint.color = color

                miCommunityIconPaint.alpha = 255

                canvas.save()

                canvas.translate(centerX - iconSize / 2f, iconCenterY - iconSize / 2f)

                val vectorScale = iconSize / MI_COMMUNITY_ICON_VIEWPORT

                canvas.scale(vectorScale, vectorScale)

                canvas.drawPath(miCommunityIconPaths[index], miCommunityIconPaint)

                canvas.restore()

            }



            miCommunityLabelPaint.color = color

            miCommunityLabelPaint.alpha = 255

            canvas.drawText(

                MI_COMMUNITY_LABELS[index],

                centerX,

                labelBaseline,

                miCommunityLabelPaint,

            )

            canvas.restore()

        }

        miCommunityIconPaint.colorFilter = null

    }



    /**

     * Redraw Xiaomi Home's individual APK tab drawables in the glass coordinate

     * space.  The native 60 dp row stays alive only as the page controller; its

     * layout and Lottie selection background are never scaled into the glass.

     */

    private fun drawMiHomeNavigation(canvas: Canvas, extraScale: Float, selectedSlot: Int) {

        if (slotCount !in 4..5 || width <= 0 || height <= 0) return

        val items = miHomeTabViews()

        val slotWidth = tabWidthPx()

        val horizontalPadding = 4f * density

        val iconSize = MI_HOME_ICON_SIZE_DP * MI_HOME_ICON_SCALE * density

        val iconCenterY = MI_HOME_ICON_CENTER_Y_DP * density

        val labelBaseline = MI_HOME_LABEL_BASELINE_DP * density

        val dark = isDarkGlass()

        val normalColor = if (dark) MI_HOME_NORMAL_DARK else MI_HOME_NORMAL_LIGHT

        val itemScale = config.iconScale * extraScale

        miHomeLabelPaint.textSize = MI_HOME_LABEL_TEXT_SP * resources.displayMetrics.scaledDensity



        for ((visualIndex, index) in enabledNavigationIndices().withIndex()) {

            val selected = index == selectedSlot

            val centerX = horizontalPadding + (visualIndex + 0.5f) * slotWidth

            canvas.save()

            canvas.scale(itemScale, itemScale, centerX, height / 2f)



            val item = items.getOrNull(index)

            val destination = RectF(

                centerX - iconSize / 2f,

                iconCenterY - iconSize / 2f,

                centerX + iconSize / 2f,

                iconCenterY + iconSize / 2f,

            )

            val imageView = item?.let { readInstanceField(it, "mImageView") as? View }

            val animationView = item?.let { readInstanceField(it, "mAnimView") as? View }

            val iconView = when {

                animationView?.visibility == View.VISIBLE && animationView.width > 0 &&

                    animationView.height > 0 -> animationView

                imageView != null && imageView.width > 0 && imageView.height > 0 -> imageView

                else -> null

            }

            if (iconView != null) {

                val save = canvas.save()

                canvas.translate(destination.left, destination.top)

                canvas.scale(

                    destination.width() / iconView.width.coerceAtLeast(1),

                    destination.height() / iconView.height.coerceAtLeast(1),

                )

                val oldAlpha = iconView.alpha

                iconView.alpha = 1f

                iconView.draw(canvas)

                iconView.alpha = oldAlpha

                canvas.restoreToCount(save)

            }



            val labelView = item?.let { readInstanceField(it, "mText") } as? TextView

            val label = labelView?.text?.toString()?.trim().orEmpty()

                .ifEmpty { miHomeFallbackLabels().getOrElse(index) { "" } }

            miHomeLabelPaint.color = labelView?.currentTextColor

                ?: if (selected) MI_HOME_ACCENT_COLOR else normalColor

            miHomeLabelPaint.alpha = 255

            canvas.drawText(label, centerX, labelBaseline, miHomeLabelPaint)

            canvas.restore()

        }

        miHomeIconPaint.colorFilter = null

    }



    private fun miHomeFallbackLabels(): Array<String> =

        if (slotCount == 4) MI_HOME_LABELS_FOUR else MI_HOME_LABELS_FIVE



    /**

     * Xiaomi Market gives the Mine tab extra width when its badge is shown.

     * Re-projecting that native row can therefore never produce equal glass

     * slots. Draw the tab icons in our own fixed coordinate space and retain

     * the hidden native row only for navigation and badge state.

     */

    private fun drawNeteaseNavigation(canvas: Canvas, extraScale: Float, selectedSlot: Int) {

        if (slotCount != 4 || width <= 0 || height <= 0) return

        val slotWidth = tabWidthPx()

        val horizontalPadding = 4f * density

        val itemScale = config.iconScale * extraScale

        neteaseLabelPaint.textSize =

            NETEASE_LABEL_TEXT_SP * NETEASE_LABEL_SCALE * resources.displayMetrics.scaledDensity

        val metrics = neteaseLabelPaint.fontMetrics

        // The host extends upward to cover the mini player; anchor the labels

        // to the navigation capsule instead of the full host. Text-only tabs

        // like XHS: label vertically centred in the capsule.

        val navTop = if (!neteaseBottomBarRect.isEmpty) neteaseBottomBarRect.top else 0f

        val navHeight = if (!neteaseBottomBarRect.isEmpty) neteaseBottomBarRect.height()

        else height.toFloat()

        val labelBaseline = navTop + navHeight / 2f - (metrics.ascent + metrics.descent) / 2f

        val dark = isDarkGlass()

        // NetEase's pale pages need fully opaque black inactive labels. The

        // shared Xiaomi gray was too light over the live glass backdrop.

        val normalColor = if (dark) MI_COMMUNITY_NORMAL_DARK else Color.BLACK



        for ((visualIndex, index) in enabledNavigationIndices().withIndex()) {

            val selected = index == selectedSlot

            val centerX = horizontalPadding + (visualIndex + 0.5f) * slotWidth

            val color = if (selected) selectedNavigationAccent() else normalColor

            canvas.save()

            canvas.scale(itemScale, itemScale, centerX, navTop + navHeight / 2f)

            neteaseLabelPaint.color = color

            neteaseLabelPaint.alpha = 255

            canvas.drawText(NETEASE_LABELS[index], centerX, labelBaseline, neteaseLabelPaint)

            canvas.restore()

        }

    }



    private fun loadNeteaseDrawable(resourceName: String): android.graphics.drawable.Drawable? =

        runCatching {

            val id = resources.getIdentifier(resourceName, "drawable", NETEASE_PACKAGE)

            if (id == 0) null else resources.getDrawable(id, context.theme).mutate()

        }.onFailure { error ->

            XposedBridge.log("[OfflineGlass][NeteaseIcons] $resourceName: $error")

        }.getOrNull()



    private fun drawMiMarketNavigation(canvas: Canvas, extraScale: Float, selectedSlot: Int) {

        drawMiMarketNativeNavigation(canvas, extraScale, selectedSlot)

    }



    private val miMarketDefaultDrawables = java.util.WeakHashMap<View, android.graphics.drawable.Drawable>()



    private fun syncMiMarketTabCount() {

        if (context.packageName != MI_MARKET_PACKAGE) return

        val count = miMarketTabViews().size

        if (count !in 1..7 || count == slotCount) return

        slotCount = count

        selectedIndex = (resolveSelectedFromViewState() ?: selectedIndex).coerceIn(0, count - 1)

        dragTarget = selectedIndex.toFloat()

        indicatorPosition = dragTarget

        positionSpring.snapTo(dragTarget)

        updateHostLayoutForConfig()

        invalidate()

    }



    private fun drawMiMarketNativeNavigation(canvas: Canvas, extraScale: Float, selectedSlot: Int) {

        val tabs = miMarketTabViews()

        if (tabs.isEmpty() || width <= 0 || height <= 0) return

        val dark = isDarkGlass()

        val slotWidth = tabWidthPx()

        miMarketLabelPaint.textSize = MI_MARKET_LABEL_TEXT_SP * resources.displayMetrics.scaledDensity

        tabs.forEachIndexed { index, tab ->

            val info = readInstanceField(tab, "mTab")

            val title = (readInstanceField(tab, "mTitleView") as? TextView)?.text?.toString()

                ?: info?.let { runCatching { XposedHelpers.callMethod(it, "getTitle") as? String }.getOrNull() }

                ?: ""

            val icon = (readInstanceField(tab, "mIconView") as? ImageView)?.drawable

                ?: miMarketDefaultDrawables[tab]

                ?: info?.let {

                    runCatching { XposedHelpers.callMethod(it, "getDefaultTabIconDrawble") as? android.graphics.drawable.Drawable }.getOrNull()

                }?.also { miMarketDefaultDrawables[tab] = it }

            val centerX = 4f * density + (index + 0.5f) * slotWidth

            canvas.save()

            canvas.scale(config.iconScale * extraScale, config.iconScale * extraScale, centerX, height / 2f)

            icon?.let {

                val oldBounds = Rect(it.bounds)

                val oldFilter = it.colorFilter

                val iconWidth = MI_MARKET_ICON_WIDTH_DP * MI_MARKET_ICON_SCALE * density

                val iconHeight = iconWidth * it.intrinsicHeight.coerceAtLeast(1) / it.intrinsicWidth.coerceAtLeast(1)

                val cy = MI_MARKET_ICON_CENTER_Y_DP * density

                it.setBounds((centerX - iconWidth / 2).toInt(), (cy - iconHeight / 2).toInt(),

                    (centerX + iconWidth / 2).toInt(), (cy + iconHeight / 2).toInt())

                if (index != selectedSlot && dark) {

                    it.colorFilter = BlendModeColorFilter(MI_MARKET_NORMAL_ICON_DARK, BlendMode.SRC_IN)

                }

                try {

                    it.draw(canvas)

                } finally {

                    it.bounds = oldBounds

                    it.colorFilter = oldFilter

                }

            }

            miMarketLabelPaint.color = if (index == selectedSlot) {

                if (dark) MI_MARKET_SELECTED_TEXT_DARK else MI_MARKET_SELECTED_TEXT_LIGHT

            } else if (dark) MI_MARKET_NORMAL_ICON_DARK else MI_MARKET_NORMAL_TEXT_LIGHT

            canvas.drawText(title, centerX, MI_MARKET_LABEL_BASELINE_DP * density, miMarketLabelPaint)

            drawMiMarketBadge(canvas, tab, centerX, MI_MARKET_ICON_CENTER_Y_DP * density, MI_MARKET_ICON_WIDTH_DP * density)

            canvas.restore()

        }

    }



    private fun drawMiMarketLegacyNavigation(canvas: Canvas, extraScale: Float, selectedSlot: Int) {

        if (slotCount != 5 || width <= 0 || height <= 0) return

        val tabViews = miMarketTabViews()

        val slotWidth = tabWidthPx()

        val horizontalPadding = 4f * density

        val dark = isDarkGlass()

        val normalIcons = if (dark) miMarketNormalDarkBitmaps else miMarketNormalLightBitmaps

        val selectedIcons = if (dark) miMarketSelectedDarkBitmaps else miMarketSelectedLightBitmaps

        val iconWidth = MI_MARKET_ICON_WIDTH_DP * MI_MARKET_ICON_SCALE * density

        val iconCenterY = MI_MARKET_ICON_CENTER_Y_DP * density

        val labelBaseline = MI_MARKET_LABEL_BASELINE_DP * density

        val itemScale = config.iconScale * extraScale

        val normalLabelColor = if (dark) MI_MARKET_NORMAL_TEXT_DARK else MI_MARKET_NORMAL_TEXT_LIGHT

        val selectedLabelColor = if (dark) MI_MARKET_SELECTED_TEXT_DARK else MI_MARKET_SELECTED_TEXT_LIGHT

        miMarketLabelPaint.textSize = MI_MARKET_LABEL_TEXT_SP * resources.displayMetrics.scaledDensity



        for ((visualIndex, index) in enabledNavigationIndices().withIndex()) {

            val selected = index == selectedSlot

            val bitmap = (if (selected) selectedIcons else normalIcons)

                .getOrNull(index)

                ?.takeUnless(Bitmap::isRecycled)

            val centerX = horizontalPadding + (visualIndex + 0.5f) * slotWidth

            canvas.save()

            canvas.scale(itemScale, itemScale, centerX, height / 2f)



            if (bitmap != null && bitmap.width > 0 && bitmap.height > 0) {

                val iconHeight = iconWidth * bitmap.height.toFloat() / bitmap.width.toFloat()

                val destination = RectF(

                    centerX - iconWidth / 2f,

                    iconCenterY - iconHeight / 2f,

                    centerX + iconWidth / 2f,

                    iconCenterY + iconHeight / 2f,

                )

                // Dark-mode unselected tab bitmaps ship as the app's dim gray

                // artwork and read far worse than the white unselected labels.

                // Tint their alpha to the exact unselected label white so icon

                // and text legibility match in dark mode.

                miMarketIconPaint.colorFilter =

                    if (!selected && dark) {

                        BlendModeColorFilter(MI_MARKET_NORMAL_ICON_DARK, BlendMode.SRC_IN)

                    } else {

                        null

                    }

                miMarketIconPaint.alpha = 255

                canvas.drawBitmap(bitmap, null, destination, miMarketIconPaint)

            } else if (index == MI_MARKET_APP_INDEX) {

                drawMiMarketAppFallbackIcon(canvas, centerX, iconCenterY, iconWidth, selected, dark)

            }



            miMarketLabelPaint.color = if (selected) selectedLabelColor else normalLabelColor

            miMarketLabelPaint.alpha = 255

            canvas.drawText(MI_MARKET_LABELS[index], centerX, labelBaseline, miMarketLabelPaint)



            if (index == MI_MARKET_MINE_INDEX) tabViews.getOrNull(index)?.let { item ->

                drawMiMarketBadge(canvas, item, centerX, iconCenterY, iconWidth)

            }

            canvas.restore()

        }

        miMarketIconPaint.colorFilter = null

        miMarketIconPaint.alpha = 255

    }



    private fun drawMiMarketAppFallbackIcon(

        canvas: Canvas,

        centerX: Float,

        centerY: Float,

        iconWidth: Float,

        selected: Boolean,

        dark: Boolean,

    ) {

        val selectedColor = if (dark) MI_MARKET_SELECTED_TEXT_DARK else MI_MARKET_SELECTED_TEXT_LIGHT

        val normalColor = if (dark) MI_MARKET_NORMAL_ICON_DARK else MI_MARKET_NORMAL_TEXT_LIGHT

        miMarketIconPaint.colorFilter = null

        miMarketIconPaint.alpha = 255

        miMarketIconPaint.style = Paint.Style.FILL

        miMarketIconPaint.color = if (selected) selectedColor else normalColor

        val cell = iconWidth * 0.24f

        val gap = iconWidth * 0.10f

        val total = cell * 2f + gap

        val left = centerX - total / 2f

        val top = centerY - total / 2f

        val radius = cell * 0.23f

        repeat(2) { row ->

            repeat(2) { column ->

                val itemLeft = left + column * (cell + gap)

                val itemTop = top + row * (cell + gap)

                canvas.drawRoundRect(

                    RectF(itemLeft, itemTop, itemLeft + cell, itemTop + cell),

                    radius,

                    radius,

                    miMarketIconPaint,

                )

            }

        }

        miMarketIconPaint.style = Paint.Style.FILL

    }



    /** The badge is deliberately a separate final layer, never part of selection tinting. */

    private fun drawMiMarketBadge(

        canvas: Canvas,

        item: View,

        iconCenterX: Float,

        iconCenterY: Float,

        iconWidth: Float,

    ) {

        val number = runCatching {

            (XposedHelpers.callMethod(item, "getNumber") as? Number)?.toInt() ?: 0

        }.getOrDefault(0)

        if (number <= 0) return



        val badgeCenterX = iconCenterX + iconWidth * 0.38f

        val badgeCenterY = iconCenterY - MI_MARKET_BADGE_OFFSET_Y_DP * density

        miMarketBadgePaint.color = MI_MARKET_BADGE_COLOR

        val text = if (number > 99) "99+" else number.toString()

        val badgeHeight = MI_MARKET_BADGE_HEIGHT_DP * density

        val minimumWidth = badgeHeight

        miMarketBadgeTextPaint.textSize = MI_MARKET_BADGE_TEXT_SP * resources.displayMetrics.scaledDensity

        val badgeWidth = max(

            minimumWidth,

            miMarketBadgeTextPaint.measureText(text) + MI_MARKET_BADGE_HORIZONTAL_PADDING_DP * 2f * density,

        )

        val badgeRect = RectF(

            badgeCenterX - badgeWidth / 2f,

            badgeCenterY - badgeHeight / 2f,

            badgeCenterX + badgeWidth / 2f,

            badgeCenterY + badgeHeight / 2f,

        )

        canvas.drawRoundRect(badgeRect, badgeHeight / 2f, badgeHeight / 2f, miMarketBadgePaint)

        val metrics = miMarketBadgeTextPaint.fontMetrics

        val baseline = badgeCenterY - (metrics.ascent + metrics.descent) / 2f

        canvas.drawText(text, badgeCenterX, baseline, miMarketBadgeTextPaint)

    }



    private fun loadMiMarketTabBitmap(fileName: String): Bitmap? {

        if (fileName.isBlank()) return null

        val assetPath = "mi_market_icons/$fileName"

        // The injected class loader is not stable across Xiaomi Market's

        // resource/context rebuilds. Read the module APK's AssetManager first;

        // unlike ClassLoader.getResourceAsStream this remains valid after tab

        // and theme recreation and cannot cache a transient null forever.

        val moduleAsset = runCatching {

            context.createPackageContext(MODULE_PACKAGE, Context.CONTEXT_IGNORE_SECURITY)

                .assets

                .open(assetPath)

                .use(BitmapFactory::decodeStream)

        }.getOrNull()

        if (moduleAsset != null) return moduleAsset



        return runCatching {

            javaClass.classLoader

                ?.getResourceAsStream(assetPath)

                ?.use(BitmapFactory::decodeStream)

        }.onFailure { error ->

            XposedBridge.log("[OfflineGlass][MiMarketIcons] $fileName: $error")

        }.getOrNull()

    }



    private fun findMiHomeBottomNav(): ViewGroup? {

        if (context.packageName != MI_HOME_PACKAGE) return null

        var ancestor: View? = navigationSource

        repeat(8) {

            if (ancestor?.javaClass?.name == MI_HOME_BOTTOM_NAV_CLASS) return ancestor as? ViewGroup

            ancestor = ancestor?.parent as? View

        }

        val root = navigationSource ?: (getChildAtOrNull(0) as? ViewGroup) ?: return null

        var scanRoot: View = root

        repeat(5) { scanRoot = (scanRoot.parent as? View) ?: scanRoot }

        val stack = ArrayDeque<Pair<View, Int>>()

        stack += scanRoot to 0

        while (stack.isNotEmpty()) {

            val (view, depth) = stack.removeLast()

            if (view.javaClass.name == MI_HOME_BOTTOM_NAV_CLASS) return view as? ViewGroup

            if (view is ViewGroup && depth < 10) {

                for (index in view.childCount - 1 downTo 0) {

                    stack += view.getChildAt(index) to (depth + 1)

                }

            }

        }

        return null

    }



    private fun miHomeTabViews(): List<View> {

        val bottomNav = findMiHomeBottomNav() ?: return emptyList()

        val reflected = runCatching {

            XposedHelpers.callMethod(bottomNav, "getTabViewList") as? List<*>

        }.getOrNull()?.filterIsInstance<View>().orEmpty()

        if (reflected.size >= slotCount) return reflected.take(slotCount)

        return (0 until bottomNav.childCount)

            .map(bottomNav::getChildAt)

            .filter { it.javaClass.name.endsWith("TabPageIndicatorNew\$TabView") }

            .take(slotCount)

    }



