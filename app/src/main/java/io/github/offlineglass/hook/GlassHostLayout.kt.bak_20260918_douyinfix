                ancestor.background = null

                ancestor.backgroundTintList = null

                ancestor.foreground = null

                if (ancestor.elevation > 0f) ancestor.elevation = 0f

                if (ancestor.translationZ > 0f) ancestor.translationZ = 0f

            }

