            if (jdCheckoutDiscoveryExhausted || now < jdNextCheckoutFindAt) {

                return@OnGlobalLayoutListener

            }

            val found = findJdCheckoutBar(liveRoot, liveRoot.width, liveRoot.height)

            if (found != null) {

                jdCheckoutBar = java.lang.ref.WeakReference(found)

                jdNextCheckoutFindAt = 0L

                correctJdCheckoutBar()

            } else {

                // Page switches fire bursts of layout events; a failed full-

                // tree search on each burst frame is the jank source. Share

                // the probe's backoff window.

                jdCheckoutDiscoveryExhausted = true

                jdNextCheckoutFindAt = Long.MAX_VALUE

            }

        }

        jdRootLayoutListener = listener

        jdRootLayoutWired = java.lang.ref.WeakReference(root)

        root.viewTreeObserver.addOnGlobalLayoutListener(listener)

