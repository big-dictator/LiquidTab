    /** Draw JD's cached icons with theme-based color tinting, scaled by the

     *  slot transform factor to match the visual slot size. The entire cached

     *  slot (icon + label) is drawn with correct aspect ratio; no separate

     *  label text is drawn to avoid double-text. */

    private fun drawJdStaticNavigation(

        canvas: Canvas,

        extraScale: Float,

        selectedSlot: Int = selectedIndex,

    ) {

        if (!jdStaticIconsPopulated || slotCount <= 0 || width <= 0 || height <= 0) return

        if (jdNativeFrameWidth <= 0 || jdNativeFrameHeight <= 0) return

        val slotWidth = tabWidthPx()

        val horizontalPadding = 4f * density

        val dark = isDarkGlass()

        val unselectedColor = if (dark) Color.WHITE else 0xFF8C8C8C.toInt()

        // JD's rebuilt navigation path stores each complete native slot

        // (icon + label) and fits that bitmap into LiquidTab's taller floating

        // host. The fit is intentionally aspect-preserving, but without an

        // app-specific compensation both parts render visibly smaller than

        // the original row. Scale the complete slot as one unit so icon/label

        // spacing and deterministic static-state behaviour stay intact.

        val itemScale = config.iconScale * extraScale * JD_STATIC_CONTENT_SCALE

        val contentCenterY = height / 2f + JD_STATIC_CONTENT_OFFSET_Y_DP * density



        for ((visualIndex, index) in enabledNavigationIndices().withIndex()) {

            val selected = index == selectedSlot

            val bitmap = jdStaticIcons.getOrNull(index)?.takeUnless(Bitmap::isRecycled) ?: continue

            val centerX = horizontalPadding + (visualIndex + 0.5f) * slotWidth

            val color = if (selected) 0xFFE02E24.toInt() else unselectedColor

            canvas.save()

            canvas.scale(itemScale, itemScale, centerX, contentCenterY)



            jdIconPaint.colorFilter = BlendModeColorFilter(color, BlendMode.SRC_IN)

            jdIconPaint.alpha = if (selected) 255 else 235

            // Draw the cached slot at the visual slot width, maintaining the

            // native aspect ratio — same logic as sourceTransformForSlot.

            val bmpW = bitmap.width.toFloat().coerceAtLeast(1f)

            val bmpH = bitmap.height.toFloat().coerceAtLeast(1f)

            val drawScale = min(slotWidth / bmpW, height / bmpH)

            val drawWidth = bmpW * drawScale

            val drawHeight = bmpH * drawScale

            val iconCenterY = contentCenterY

            val iconRect = RectF(

                centerX - drawWidth / 2f,

                iconCenterY - drawHeight / 2f,

                centerX + drawWidth / 2f,

                iconCenterY + drawHeight / 2f,

            )

            canvas.drawBitmap(bitmap, null, iconRect, jdIconPaint)

            // Badges are native artwork, not selection-state icon content.

            // Draw them last with no tint so their original red/white pixels

            // remain intact on Message, Cart and Mine.

            jdIconPaint.colorFilter = null

            jdIconPaint.alpha = 255

            jdBadgeOverlays.getOrNull(index).orEmpty().forEach { overlay ->

                val destination = RectF(

                    iconRect.left + overlay.slotRect.left * drawScale,

                    iconRect.top + overlay.slotRect.top * drawScale,

                    iconRect.left + overlay.slotRect.right * drawScale,

                    iconRect.top + overlay.slotRect.bottom * drawScale,

                )

                canvas.drawBitmap(overlay.bitmap, null, destination, jdIconPaint)

            }

            canvas.restore()

        }

        jdIconPaint.colorFilter = null

        jdIconPaint.alpha = 255

        jdLabelPaint.alpha = 255

    }

    private fun amapCells(source: ViewGroup): List<ViewGroup> {
        val cells = ArrayList<ViewGroup>()
        val stack = ArrayDeque<View>()
        stack += source
        while (stack.isNotEmpty()) {
            val v = stack.removeLast()
            if (v is ViewGroup && v.javaClass.name.endsWith("TabItemLayoutV2")) {
                cells += v
            } else if (v is ViewGroup) {
                for (i in 0 until v.childCount) stack += v.getChildAt(i)
            }
        }
        val loc = IntArray(2)
        return cells.sortedBy { it.getLocationInWindow(loc); loc[0] }
    }

    private fun amapCellIcon(cell: ViewGroup): android.graphics.drawable.Drawable? {
        // Prefer the dedicated icon holder (R.id.tab_img); fall back to the
        // largest ImageView in the cell, excluding the right-top badge anchor.
        val tabImgId = runCatching { resources.getIdentifier("tab_img", "id", AMAP_PACKAGE) }.getOrDefault(0)
        if (tabImgId != 0) {
            (cell.findViewById<View>(tabImgId) as? ImageView)?.drawable?.let { return it }
        }
        var best: ImageView? = null
        var bestArea = 0
        val stack = ArrayDeque<Pair<View, Int>>()
        stack += cell to 0
        while (stack.isNotEmpty()) {
            val (v, depth) = stack.removeLast()
            if (v is ImageView && depth <= 4) {
                val a = v.width * v.height
                if (a > bestArea && v.id != 0) {
                    bestArea = a
                    best = v
                }
            }
            if (v is ViewGroup && depth < 5) for (i in 0 until v.childCount) stack += v.getChildAt(i) to (depth + 1)
        }
        return best?.drawable?.takeIf { it.intrinsicWidth > 0 && it.intrinsicHeight > 0 }
            ?: best?.drawable
    }

    private fun amapCellLabel(cell: ViewGroup): String? {
        for (name in listOf("tab_name_v2", "tab_name")) {
            val id = runCatching { resources.getIdentifier(name, "id", AMAP_PACKAGE) }.getOrDefault(0)
            if (id != 0) {
                (cell.findViewById<View>(id) as? TextView)?.text?.toString()
                    ?.takeIf { it.isNotBlank() }?.let { return it }
            }
        }
        val stack = ArrayDeque<Pair<View, Int>>()
        stack += cell to 0
        while (stack.isNotEmpty()) {
            val (v, depth) = stack.removeLast()
            if (v is TextView && depth <= 4) {
                v.text?.toString()?.trim()?.takeIf { it.length in 1..6 }?.let { return it }
            }
            if (v is ViewGroup && depth < 5) for (i in 0 until v.childCount) stack += v.getChildAt(i) to (depth + 1)
        }
        return null
    }

    private fun amapIconBitmap(d: android.graphics.drawable.Drawable): Bitmap? {
        val w = d.intrinsicWidth
        val h = d.intrinsicHeight
        if (w <= 0 || h <= 0) return null
        return runCatching {
            val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
            val c = Canvas(bmp)
            d.setBounds(0, 0, w, h)
            d.draw(c)
            bmp
        }.onFailure { XposedBridge.log("[OfflineGlass][Amap] icon bitmap: $it") }.getOrNull()
    }

    private fun populateAmapStaticIcons(source: ViewGroup): Boolean {
        if (amapStaticIconsPopulated) return true
        val cells = amapCells(source)
        if (cells.isEmpty()) return false
        var filled = 0
        for (i in cells.indices) {
            if (i >= amapStaticIcons.size) break
            val iconBmp = amapCellIcon(cells[i])?.let(::amapIconBitmap)
            if (iconBmp != null) {
                amapStaticIcons[i]?.takeUnless(Bitmap::isRecycled)?.recycle()
                amapStaticIcons[i] = iconBmp
                filled++
            }
            amapStaticLabels[i] = amapCellLabel(cells[i])
        }
        amapStaticIconsPopulated = filled > 0
        if (amapStaticIconsPopulated) {
            // Hide the native row so its halo + left-aligned icon art never
            // bleeds through the module's centred redraw; cells stay the
            // click/selection targets.
            runCatching { if (source.alpha != 0f) source.alpha = 0f }
        }
        XposedBridge.log("[OfflineGlass][Amap] populated icons: $filled/${cells.size}")
        return amapStaticIconsPopulated
    }

    private fun isAmapAIChatActive(): Boolean {
        val now = SystemClock.uptimeMillis()
        if (now - amapAiChatCacheAt < AMAP_AICHAT_ACTIVE_CACHE_MS) return amapAiChatCached
        amapAiChatCacheAt = now
        val root = rootView ?: return amapAiChatCached
        val stack = ArrayDeque<View>()
        stack += root
        var found = false
        var scanned = 0
        while (stack.isNotEmpty() && !found) {
            val v = stack.removeLast()
            val cls = v.javaClass.name
            // The AI chat page renders as AJX surfaces in the AI-bundle; any
            // shown "ainative" chat view means 长按说话 is on screen.
            if (cls.contains("ainative") && (cls.contains("Chat") || cls.contains("AIChat") || cls.contains("AJXContainer"))) {
                found = v.isShown
            }
            if (!found && v is ViewGroup && scanned++ < 4096) {
                for (i in 0 until v.childCount) stack += v.getChildAt(i)
            }
        }
        amapAiChatCached = found
        return found
    }

    private fun drawAmapNavigation(canvas: Canvas, extraScale: Float) {
        if (!amapStaticIconsPopulated || slotCount <= 0 || width <= 0 || height <= 0) return
        // The dead-centre "长按说话" tab is an action, not a persistent page:
        // it may be tapped to open the AI chat but must never capture the
        // liquid slider, mirroring native selection behaviour.
        nonSelectableIndices = setOf(AMAP_TALK_TAB_INDEX)
        val slotWidth = tabWidthPx()
        val horizontalPadding = 4f * density
        val dark = isDarkGlass()
        val unselectedColor = if (dark) AMAP_UNSELECTED_DARK else AMAP_UNSELECTED_LIGHT
        val accent = selectedNavigationAccent()
        val itemScale = config.iconScale * extraScale
        val densityScale = resources.displayMetrics.scaledDensity
        amapLabelPaint.textSize = AMAP_LABEL_TEXT_SP * densityScale
        val fm = amapLabelPaint.fontMetrics
        val labelHeight = fm.descent - fm.ascent
        // Icon + fixed gap + label form one group centred vertically in the
        // host, so enlarging the icon never unbalances the composition.
        val viewport = AMAP_ICON_VIEWPORT_DP * density
        val gap = AMAP_LABEL_GAP_DP * density
        val groupHeight = viewport + gap + labelHeight
        val groupTop = height / 2f - groupHeight / 2f
        val iconCenterY = groupTop + viewport / 2f
        val labelBaseline = groupTop + viewport + gap + (-fm.ascent)

        for ((visualIndex, index) in enabledNavigationIndices().withIndex()) {
            val selected = index == selectedIndex
            val centerX = horizontalPadding + (visualIndex + 0.5f) * slotWidth
            val bmp = amapStaticIcons.getOrNull(index)?.takeUnless(Bitmap::isRecycled) ?: continue
            val label = amapStaticLabels.getOrNull(index)
            val color = if (selected) accent else unselectedColor
            val w = bmp.width.toFloat().coerceAtLeast(1f)
            val h = bmp.height.toFloat().coerceAtLeast(1f)
            val s = (viewport / max(w, h)).coerceAtMost(1.15f)
            val dw = w * s
            val dh = h * s
            canvas.save()
            canvas.scale(itemScale, itemScale, centerX, iconCenterY)
            navigationPaint.colorFilter = BlendModeColorFilter(color, BlendMode.SRC_IN)
            navigationPaint.alpha = if (selected) 255 else 235
            canvas.drawBitmap(bmp, null, RectF(centerX - dw / 2f, iconCenterY - dh / 2f, centerX + dw / 2f, iconCenterY + dh / 2f), navigationPaint)
            if (label != null) {
                amapLabelPaint.color = color
                amapLabelPaint.alpha = if (selected) 255 else 235
                canvas.drawText(label, centerX, labelBaseline, amapLabelPaint)
            }
            canvas.restore()
        }
        navigationPaint.colorFilter = null
        navigationPaint.alpha = 255
        amapLabelPaint.alpha = 255
    }

    private fun maybePopulateAmapIcons() {
        if (context.packageName != AMAP_PACKAGE) return
        if (amapStaticIconsPopulated || amapPopulateAttempted) return
        val src = navigationSource ?: return
        if (src.width <= 0 || src.height <= 0) return
        amapPopulateAttempted = true
        src.postDelayed({
            if (!amapStaticIconsPopulated && navigationSource != null && navigationSource!!.width > 0) {
                populateAmapStaticIcons(navigationSource!!)
            }
        }, 280)
    }



    /**

     * Draw Weibo's own light/dark, selected/unselected assets in LiquidTab's

     * Draw Weibo's own light/dark, selected/unselected assets in LiquidTab's

     * stable coordinate space. The native row stays attached only as the page

     * controller and badge source, so feed cards and transient tab animations

     * can never be captured into the liquid bar.

     */

    private fun drawWeiboNavigation(

        canvas: Canvas,

        extraScale: Float,

        selectedSlot: Int = selectedIndex,

    ) {

        if (slotCount != WEIBO_NAV_LABELS.size || width <= 0 || height <= 0) return

        val slotWidth = tabWidthPx()

        val horizontalPadding = 4f * density

        val iconSize = WEIBO_ICON_SIZE_DP * density

        // Pull both elements toward the group centre, reducing the gap without

        // shifting the complete icon-label group up or down.

        val iconCenterY = WEIBO_ICON_CENTER_Y_DP * density

        val labelBaseline = WEIBO_LABEL_BASELINE_DP * density

        val dark = isDarkGlass()

        val normalIcons = if (dark) weiboNormalDarkBitmaps else weiboNormalLightBitmaps

        val selectedIcons = if (dark) weiboSelectedDarkBitmaps else weiboSelectedLightBitmaps

        val normalLabelColor = if (dark) Color.WHITE else WEIBO_DARK_LABEL_COLOR

        val itemScale = config.iconScale * extraScale

        weiboLabelPaint.textSize = 11f * resources.displayMetrics.scaledDensity

        weiboBadgeTextPaint.textSize = 9f * resources.displayMetrics.scaledDensity



        for ((visualIndex, index) in enabledNavigationIndices().withIndex()) {

            val selected = index == selectedSlot

            val bitmap = (if (selected) selectedIcons else normalIcons).getOrNull(index) ?: continue

            val centerX = horizontalPadding + (visualIndex + 0.5f) * slotWidth

            canvas.save()

            canvas.scale(itemScale, itemScale, centerX, height / 2f)



            weiboIconPaint.alpha = if (selected) 255 else 238

            // Dark mode: unify unselected icons with the label color (white)

            // so the whole row reads as one unselected treatment.

            weiboIconPaint.colorFilter = if (dark && !selected) {

                BlendModeColorFilter(Color.WHITE, BlendMode.SRC_IN)

            } else {

                null

            }

            val iconRect = RectF(

                centerX - iconSize / 2f,

                iconCenterY - iconSize / 2f,

                centerX + iconSize / 2f,

                iconCenterY + iconSize / 2f,

            )

            canvas.drawBitmap(bitmap, null, iconRect, weiboIconPaint)



            weiboLabelPaint.color = if (selected) WEIBO_ACCENT_COLOR else normalLabelColor

            weiboLabelPaint.alpha = if (selected) 255 else 238

            canvas.drawText(WEIBO_NAV_LABELS[index], centerX, labelBaseline, weiboLabelPaint)



            val badge = weiboBadgeTexts.getOrNull(index)

            if (!badge.isNullOrBlank()) {

                val badgeCenterX = centerX + 13f * density

                val badgeCenterY = 13f * density

                val badgeRadius = if (badge.length <= 1) 8f * density else 10f * density

                canvas.drawCircle(badgeCenterX, badgeCenterY, badgeRadius, weiboBadgePaint)

                val metrics = weiboBadgeTextPaint.fontMetrics

                val badgeBaseline = badgeCenterY - (metrics.ascent + metrics.descent) / 2f

                canvas.drawText(badge, badgeCenterX, badgeBaseline, weiboBadgeTextPaint)

            }

            canvas.restore()

        }

        weiboIconPaint.alpha = 255

        weiboIconPaint.colorFilter = null

        weiboLabelPaint.alpha = 255

    }



    private fun loadWeiboTabBitmap(fileName: String): Bitmap? {

        val assetPath = "weibo/$fileName"

        val moduleAsset = runCatching {

            context.createPackageContext(MODULE_PACKAGE, Context.CONTEXT_IGNORE_SECURITY)

                .assets

                .open(assetPath)

                .use(BitmapFactory::decodeStream)

