    /**

     * Universal veil gate (design/底部渐变模糊设计规范.md §5): the gradient

     * blur follows only a bar that is showing, and only on the pages each app

     * adapter opted in. Indices are the native tab order, unaffected by the

     * module's hidden-slot mask. Weibo keeps one gate: its bar only stays on

     * 首页(含发�?/�? because the 视频 and 消息 tabs auto-hide it.

     */

    private fun bottomVeilWantsBlur(barVisible: Boolean): Boolean {

        if (config.solidBarEnabled || !config.bottomGradientBlurEnabled || !barVisible) return false

        return when (context.packageName) {

            BILIBILI_PACKAGE -> selectedIndex != BILIBILI_PUBLISH_INDEX &&

                selectedIndex != BILIBILI_SHOP_INDEX

            // International has no publish button and no shop tab: every page

            // keeps the universal veil (底部渐变模糊设计规范.md).

            BILIBILI_IN_PACKAGE -> true

            XHS_PACKAGE -> selectedIndex == XHS_HOME_INDEX || selectedIndex == XHS_MARKET_INDEX

            WEIBO_PACKAGE -> true

            PDD_PACKAGE -> selectedIndex != PDD_VIDEO_INDEX

            TAOBAO_PACKAGE -> (selectedIndex == TAOBAO_HOME_INDEX ||

                selectedIndex == TAOBAO_PROFILE_INDEX ||

                selectedIndex == TAOBAO_CART_INDEX) && !taobaoFliggyChannelActive

            // Mi Home keeps its bar visible on every page, so per the user's

            // 2026-09-03 request the universal veil follows on all of them.

            // The Store page's lifted orange purchase strip sits above the

            // veil zone (its bottom is raised to barTop - gap) and stays sharp.

            MI_HOME_PACKAGE -> true

            MI_HEALTH_PACKAGE -> true

            JD_PACKAGE -> true

            MEITUAN_PACKAGE -> selectedIndex == 0

