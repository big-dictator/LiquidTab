    /**

     * New Products owns a custom full-page renderer which can restore its own

     * measured height after every feed update. Re-applying our content-spine

     * layout params from every pre-draw creates a layout tug-of-war, while

     * referencing the texture-backed scene from a second RenderNode can make

     * whole tiles disappear. Detection is cached in steady state; this page

     * keeps the extended outer viewport but uses compositor-native blur.

     */

    private fun refreshJdNewProductsChannel(root: ViewGroup, now: Long) {

        if (selectedIndex != 0) {

            jdNewProductsChannelActive = false

            jdNewProductsRenderer = null

            return

        }

        val cached = jdNewProductsRenderer?.get() as? TextView

        if (cached != null && cached.isAttachedToWindow && cached.isShown &&

            cached.text?.toString()?.trim() == JD_NEW_PRODUCTS_CHANNEL_LABEL &&

            (cached.isSelected || cached.contentDescription?.toString()?.contains(JD_SELECTED_DESCRIPTION) == true)

        ) {

            jdNewProductsChannelActive = true

            return

        }

        if (now - jdLastNewProductsProbeAt < JD_NEW_PRODUCTS_PROBE_INTERVAL_MS) return

        jdLastNewProductsProbeAt = now

        var found: TextView? = null

        var visited = 0

        val stack = ArrayDeque<View>()

        stack += root

        while (stack.isNotEmpty() && visited++ < JD_NEW_PRODUCTS_PROBE_MAX_VIEWS) {

            val view = stack.removeLast()

            if (view is TextView &&

                view.text?.toString()?.trim() == JD_NEW_PRODUCTS_CHANNEL_LABEL &&

                view.isAttachedToWindow && view.isShown && view.alpha > 0.001f &&

                (view.isSelected || view.contentDescription?.toString()?.contains(JD_SELECTED_DESCRIPTION) == true)

            ) {

                found = view

                break

            }

            if (view is ViewGroup) {

                for (index in 0 until view.childCount) stack += view.getChildAt(index)

            }

        }

        val wasActive = jdNewProductsChannelActive

        jdNewProductsRenderer = found?.let { java.lang.ref.WeakReference<View>(it) }

        jdNewProductsChannelActive = found != null

        if (jdNewProductsChannelActive && !wasActive) {

            jdNewProductsSnapshotDirty = true

            restoreJdGeometryForNewProducts()

            // Controls cached from the neighbouring 秒送 channel must not be

            // corrected while its fragment is transitioning out.

            jdFlashBanner = null

            jdFlashCart = null

            jdNextFlashFindAt = now + JD_FLASH_INACTIVE_PROBE_BACKOFF_MS

        } else if (!jdNewProductsChannelActive && wasActive) {

            jdNewProductsSnapshotDirty = true

            // The ordinary Home channels can safely use the existing

            // full-height content spine again.

            jdContentAdjustedSource = null

            jdCollapsedBar = null

        }

    }



    private fun restoreJdGeometryForNewProducts() {

