<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="io.github.offlineglass.permission.CONFIG_SYNC"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.offlineglass.permission.CONFIG_SYNC" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Intentionally no INTERNET or ACCESS_NETWORK_STATE permission. -->
    <!-- Launcher-intent visibility: the manager UI resolves target apps' icons
         via PackageManager; per-package entries drifted out of sync with
         AppCatalog before, so declare launcher visibility once for all apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflineGlass">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <provider
            android:name=".config.SettingsProvider"
            android:authorities="io.github.offlineglass.settings"
            android:directBootAware="true"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- Explicit request/reply fallback for target apps whose package
             visibility policy hides the exported SettingsProvider. -->
        <receiver
            android:name=".config.ConfigRequestReceiver"
            android:exported="true" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
        
    </application>
</manifest>
